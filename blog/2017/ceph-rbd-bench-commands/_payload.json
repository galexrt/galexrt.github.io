create an image for this would be:",[568,569,574],"pre",{"className":570,"code":571,"language":572,"meta":573,"style":573},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","$ RBD_IMAGE_NAME=\"bench1\"\n$ rbd create --size=10G $RBD_IMAGE_NAME\n","bash","",[575,576,577,600],"code",{"__ignoreMap":573},[578,579,582,586,590,594,597],"span",{"class":580,"line":581},"line",1,[578,583,585],{"class":584},"sBMFI","$",[578,587,589],{"class":588},"sfazB"," RBD_IMAGE_NAME=",[578,591,593],{"class":592},"sMK4o","\"",[578,595,596],{"class":588},"bench1",[578,598,599],{"class":592},"\"\n",[578,601,603,605,608,611,614],{"class":580,"line":602},2,[578,604,585],{"class":584},[578,606,607],{"class":588}," rbd",[578,609,610],{"class":588}," create",[578,612,613],{"class":588}," --size=10G",[578,615,617],{"class":616},"sTEyZ"," $RBD_IMAGE_NAME\n",[532,619,621],{"id":620},"rbd-bench","rbd bench",[623,624,626],"h3",{"id":625},"flags","Flags",[537,628,629,630,633],{},"Takes normal ",[575,631,632],{},"rbd"," command flags like:",[635,636,637],"ul",{},[638,639,640,643,644,647],"li",{},[575,641,642],{},"-p"," or ",[575,645,646],{},"--pool"," for the rbd pool to use.",[537,649,650],{},"The following flags are for the benchmark configuration:",[635,652,653,659,665,671,677],{},[638,654,655,658],{},[575,656,657],{},"--io-type"," if read or write IO should be run.",[638,660,661,664],{},[575,662,663],{},"--io-size"," how big every IO should be (in B\u002FK\u002FM\u002FG\u002FT).",[638,666,667,670],{},[575,668,669],{},"--io-threads"," how many IOs are done in parallel.",[638,672,673,676],{},[575,674,675],{},"--io-total"," how much total IO should be done.",[638,678,679,682],{},[575,680,681],{},"--io-pattern"," sequential or random IO pattern.",[623,684,686],{"id":685},"benchmarks","Benchmarks",[688,689,691],"h4",{"id":690},"write-benchmark","Write Benchmark",[537,693,694],{},"For sequential write benchmark:",[568,696,698],{"className":570,"code":697,"la