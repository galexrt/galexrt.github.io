 NetworkManager service with this command:",[564,565,570],"pre",{"className":566,"code":567,"language":568,"meta":569,"style":569},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","systemctl disable NetworkManager.service\n","bash","",[551,571,572],{"__ignoreMap":569},[573,574,577,581,585],"span",{"class":575,"line":576},"line",1,[573,578,580],{"class":579},"sBMFI","systemctl",[573,582,584],{"class":583},"sfazB"," disable",[573,586,587],{"class":583}," NetworkManager.service\n",[535,589,590,591,594],{},"And enable the old fashioned ",[551,592,593],{},"network.service"," with:",[564,596,598],{"className":566,"code":597,"language":568,"meta":569,"style":569},"systemctl enable network.service\n",[551,599,600],{"__ignoreMap":569},[573,601,602,604,607],{"class":575,"line":576},[573,603,580],{"class":579},[573,605,606],{"class":583}," enable",[573,608,609],{"class":583}," network.service\n",[532,611,612,617],{},[535,613,614],{},[538,615,616],{},"WARNING",[535,618,619,620,623],{},"You need to have properly configured network-scripts for your other \"normal\" interfaces too (like ",[551,621,622],{},"enp3s0",") or else after a reboot the network connectivity to your server will not work correctly!!",[535,625,626],{},"We can now go on to creating the configuration for the OpenVSwitch bridges and ports.",[556,628,630],{"id":629},"creating-configuration-for-an-interface-named-obr0","Creating configuration for an interface named obr0",[532,632,633,637],{},[535,634,635],{},[538,636,540],{},[535,638,639],{},"You should only need to persist IP configurations for bridge devices and not ports.",[535,641,642,643,646],{},"Create a file called ",[551,644,645],{},"\u002Fetc\u002Fsysconfig\u002Fnetwork-scripts\u002Fifcfg-obr0",":",[564,648,652],{"className":649,"code":650,"language":651,"meta":569,"style":569},"language-ini shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","NAME=\"obr0\"\nDEVICE=\"obr0\"\nNM_CONTROLLED=\"yes\"\nONBOOT=\"yes\"\nIPV6INIT=no\nTYPE=\"OVSBridge\"\nDEVICETYPE=\"ovs\"\nMTU=1400\nIPADDR=10.244.1.0\nPREFIX=16\n","ini",[551,653,654,673,687,702,716,728,743,758,769,780],{"__ignoreMap":569},[573,655,656,660,664,667,670],{"class":575,"line":576},[573,657,659],{"class":658},"swJcz","NAME",[573,661,663],{"class":662},"sMK4o","=",[573,665,666],{"class":662},"\"",[573,668,669],{"class":583},"obr0",[573,671,672],{"class":662},"\"\n",[573,674,676,679,681,683,685],{"class":575,"line":675},2,[573,677,678],{"class":658},"DEVICE",[573,680,663],{"class":662},[573,682,666],{"class":662},[573,684,669],{"class":583},[573,686,672],{"class":662},[573,688,690,693,695,697,700],{"class":575,"line":689},3,[573,691,692],{"class":658},"NM_CONTROLLED",[573,694,663],{"class":662},[573,696,666],{"class":662},[573,698,699],{"class":583},"yes",[573,701,672],{"class":662},[573,703,705,708,710,712,714],{"class":575,"line":704},4,[573,706,707],{"class":658},"ONBOOT",[573,709,663],{"class":662},[573,711,666],{"class":662},[573,713,699],{"class":583},[573,715,672],{"class":662},[573,717,719,722,724],{"class":575,"line":718},5,[573,720,721],{"class":658},"IPV6INIT",[573,723,663],{"class":662},[573,725,727],{"class":726},"sTEyZ","no\n",[573,729,731,734,736,738,741],{"class":575,"line":730},6,[573,732,733],{"class":658},"TYPE",[573,735,663],{"class":662},[573,737,666],{"class":662},[573,739,740],{"class":583},"OVSBridge",[573,742,672],{"class":662},[573,744,746,749,751,753,756],{"class":575,"line":745},7,[573,747,748],{"class":658},"DEVICETYPE",[573,750,663],{"class":662},[573,752,666],{"class":662},[573,754,755],{"class":583},"ovs",[573,757,672],{"class":662},[573,759,761,764,766],{"class":575,"line":760},8,[573,762,763],{"class":658},"MTU",[573,765,663],{"class":662},[573,767,768],{"class":726},"1400\n",[573,770,772,775,777],{"class":575,"line":771},9,[573,773,774],{"class":658},"IPADDR",[573,776,663],{"class":662},[573,778,779],{"class":726},"10.244.1.0\n",[573,781,783,786,788],{"class":575,"line":782},10,[573,784,785],{"class":658},"PREFIX",[573,787,663],{"class":662},[573,789,790],{"class":726},"16\n",[532,792,793],{},[535,794,795],{},[538,796,797],{},"WDWD",[799,800,801,808,813,818,830,835,846,855,861,867],"ul",{},[802,803,804,807],"li",{},[551,805,806],{},"NAME=\"YOUR_INTERFACE_NAME\""," - The name of the interface.",[802,809,810,807],{},[551,811,812],{},"DEVICE=\"YOUR_DEVICE_NAME\"",[802,814,815,807],{},[551,816,817],{},"NM_CONTROLLED=\"yes\"",[802,819,820,823,824,826,827,829],{},[551,821,822],{},"ONBOOT=\"INTERFACE_NAME\""," - If ",[551,825,699],{},", the interface is created when the server boots. Should be ",[551,828,699],{}," in most cases.",[802,831,832,807],{},[551,833,834],{},"IPV6INIT=\"INTERFACE_NAME\"",[802,836,837,840,841,845],{},[551,838,839],{},"TYPE=\"OVSBridge\""," - The type of the  interface (see ",[545,842,844],{"href":843},"#OpenVSwitch-related-configuration","OpenVSwitch related configuration"," for more info)",[802,847,848,851,852,854],{},[551,849,850],{},"DEVICETYPE=\"ovs\""," - The device type of the interface (see ",[545,853,844],{"href":843}," for more info).",[802,856,857,860],{},[551,858,859],{},"MTU=YOUR_MTU"," - The MTU of the interface (Only add this option if you know what you are doing).",[802,862,863,866],{},[551,864,865],{},"IPADDR=YOUR_INTERFACE_IP_ADDRESS"," - The name of the created interface.",[802,868,869,866],{},[551,870,871],{},"PREFIX=YOUR_NETWORK_PREFIX",[556,873,844],{"id":874},"openvswitch-related-configuration",[535,876,877],{},"The following options\u002Farguments are important when configuring OpenVSwitch created interfaces:",[799,879,880,892],{},[802,881,882,884,885,887,888,891],{},[551,883,748],{}," - For a bridge interface use ",[551,886,740],{}," and for a port interface use ",[551,889,890],{},"OVSPort",".",[802,893,894,896,897,899],{},[551,895,733],{}," - Always ",[551,898,755],{}," for a OpenVSwitch interface.",[556,901,903],{"id":902},"summary","Summary",[535,905,906,907,910,911,914],{},"That's all you need to do, disable the ",[551,908,909],{},"NetworkManager.service"," and activate the good old ",[551,912,913],{},"network"," service.",[916,917,918],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html pre.shiki code .swJcz, html code.shiki .swJcz{--shiki-light:#E53935;--shiki-default:#F07178;--shiki-dark:#F07178}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}",{"title":569,"searchDepth":675,"depth":675,"links":920},[921,922,923,924],{"id":558,"depth":675,"text":559},{"id":629,"depth":675,"text":630},{"id":874,"depth":675,"text":844},{"id":902,"depth":675,"text":903},"2016-08-11T18:22:22+02:00","Persisting the interface IP configuration for OpenVSwitch interfaces\u002Fdevices under Rhel based distros.","md",{"src":929},"\u002Fblog\u002F2016\u002Fopenvswitch-persistent-ip-configuration-under-rhel-based-distros\u002Fpost_title_image.png",{"tags":931},[193,932],"OpenVSwitch",true,"\u002Fblog\u002F2016\u002Fopenvswitch-persistent-ip-configuration-under-rhel-based-distros",{"title":520,"description":926},"3.blog\u002F2016\u002Fopenvswitch-persistent-ip-configuration-under-rhel-based-distros","RtcGdqGaRpDxDghMZFFNEZKJuBxQ_KijBRc01p7ilzE",[939,943],{"title":548,"path":940,"stem":941,"description":942,"children":-1},"\u002Fblog\u002F2016\u002Fopenvswitch-multi-host-overlay-network","3.blog\u002F2016\u002Fopenvswitch-multi-host-overlay-network","Creating a mutli-host overlay network between two and more servers.",{"title":944,"path":945,"stem":946,"description":947,"children":-1},"PSA: Keep your computer clean!","\u002Fblog\u002F2016\u002Fpsa-keep-your-computer-clean","3.blog\u002F2016\u002Fpsa-keep-your-computer-clean","Keep your computer(s) clean for them to work even now when a hot summer is around the corner.",1793409781409]