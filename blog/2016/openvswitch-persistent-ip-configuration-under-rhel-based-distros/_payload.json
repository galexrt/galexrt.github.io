[{"data":1,"prerenderedAt":948,"buildId":949},["ShallowReactive",2],{"\u002Fblog\u002F2016\u002Fopenvswitch-persistent-ip-configuration-under-rhel-based-distros":3,"\u002Fblog\u002F2016\u002Fopenvswitch-persistent-ip-configuration-under-rhel-based-distros-surround":424,"navigation":434},{"id":4,"title":5,"authors":6,"badge":12,"body":13,"date":410,"description":411,"extension":412,"image":413,"meta":415,"navigation":419,"path":420,"seo":421,"stem":422,"__hash__":423},"posts\u002F3.blog\u002F2016\u002Fopenvswitch-persistent-ip-configuration-under-rhel-based-distros.md","OpenVSwitch: Persistent IP configuration under Rhel based distros",[7],{"name":8,"to":9,"avatar":10},"Alexander Trost","https:\u002F\u002Fgithub.com\u002Fgalexrt",{"src":11},"\u002Fimages\u002Fprofile-picture.webp",null,{"type":14,"value":15,"toc":404},"minimark",[16,40,45,48,73,80,95,109,112,116,125,132,276,283,357,360,363,385,389,400],[17,18,19,26],"blockquote",{},[20,21,22],"p",{},[23,24,25],"strong",{},"NOTE",[20,27,28,29,34,35,39],{},"This post is a follow up on my post ",[30,31,33],"a",{"href":32},"\u002Fblog\u002F2016\u002Fopenvswitch-multi-host-overlay-network\u002F","OpenVSwitch: Multi-Host Overlay Network",".\nThe interface in this example is named ",[36,37,38],"code",{},"br0",". Change according to your interface.",[41,42,44],"h2",{"id":43},"preparing-for-using-the-interface-configurations","Preparing for using the interface configurations",[20,46,47],{},"To persist the configurations you can either use the NetworkManager or use good old network-scripts.\nHere I'm going to show how it's done using the good old network-scripts.\nFirst at all we have to disable the NetworkManager service with this command:",[49,50,55],"pre",{"className":51,"code":52,"language":53,"meta":54,"style":54},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","systemctl disable NetworkManager.service\n","bash","",[36,56,57],{"__ignoreMap":54},[58,59,62,66,70],"span",{"class":60,"line":61},"line",1,[58,63,65],{"class":64},"sBMFI","systemctl",[58,67,69],{"class":68},"sfazB"," disable",[58,71,72],{"class":68}," NetworkManager.service\n",[20,74,75,76,79],{},"And enable the old fashioned ",[36,77,78],{},"network.service"," with:",[49,81,83],{"className":51,"code":82,"language":53,"meta":54,"style":54},"systemctl enable network.service\n",[36,84,85],{"__ignoreMap":54},[58,86,87,89,92],{"class":60,"line":61},[58,88,65],{"class":64},[58,90,91],{"class":68}," enable",[58,93,94],{"class":68}," network.service\n",[17,96,97,102],{},[20,98,99],{},[23,100,101],{},"WARNING",[20,103,104,105,108],{},"You need to have properly configured network-scripts for your other \"normal\" interfaces too (like ",[36,106,107],{},"enp3s0",") or else after a reboot the network connectivity to your server will not work correctly!!",[20,110,111],{},"We can now go on to creating the configuration for the OpenVSwitch bridges and ports.",[41,113,115],{"id":114},"creating-configuration-for-an-interface-named-obr0","Creating configuration for an interface named obr0",[17,117,118,122],{},[20,119,120],{},[23,121,25],{},[20,123,124],{},"You should only need to persist IP configurations for bridge devices and not ports.",[20,126,127,128,131],{},"Create a file called ",[36,129,130],{},"\u002Fetc\u002Fsysconfig\u002Fnetwork-scripts\u002Fifcfg-obr0",":",[49,133,137],{"className":134,"code":135,"language":136,"meta":54,"style":54},"language-ini shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","NAME=\"obr0\"\nDEVICE=\"obr0\"\nNM_CONTROLLED=\"yes\"\nONBOOT=\"yes\"\nIPV6INIT=no\nTYPE=\"OVSBridge\"\nDEVICETYPE=\"ovs\"\nMTU=1400\nIPADDR=10.244.1.0\nPREFIX=16\n","ini",[36,138,139,158,172,187,201,213,228,243,254,265],{"__ignoreMap":54},[58,140,141,145,149,152,155],{"class":60,"line":61},[58,142,144],{"class":143},"swJcz","NAME",[58,146,148],{"class":147},"sMK4o","=",[58,150,151],{"class":147},"\"",[58,153,154],{"class":68},"obr0",[58,156,157],{"class":147},"\"\n",[58,159,161,164,166,168,170],{"class":60,"line":160},2,[58,162,163],{"class":143},"DEVICE",[58,165,148],{"class":147},[58,167,151],{"class":147},[58,169,154],{"class":68},[58,171,157],{"class":147},[58,173,175,178,180,182,185],{"class":60,"line":174},3,[58,176,177],{"class":143},"NM_CONTROLLED",[58,179,148],{"class":147},[58,181,151],{"class":147},[58,183,184],{"class":68},"yes",[58,186,157],{"class":147},[58,188,190,193,195,197,199],{"class":60,"line":189},4,[58,191,192],{"class":143},"ONBOOT",[58,194,148],{"class":147},[58,196,151],{"class":147},[58,198,184],{"class":68},[58,200,157],{"class":147},[58,202,204,207,209],{"class":60,"line":203},5,[58,205,206],{"class":143},"IPV6INIT",[58,208,148],{"class":147},[58,210,212],{"class":211},"sTEyZ","no\n",[58,214,216,219,221,223,226],{"class":60,"line":215},6,[58,217,218],{"class":143},"TYPE",[58,220,148],{"class":147},[58,222,151],{"class":147},[58,224,225],{"class":68},"OVSBridge",[58,227,157],{"class":147},[58,229,231,234,236,238,241],{"class":60,"line":230},7,[58,232,233],{"class":143},"DEVICETYPE",[58,235,148],{"class":147},[58,237,151],{"class":147},[58,239,240],{"class":68},"ovs",[58,242,157],{"class":147},[58,244,246,249,251],{"class":60,"line":245},8,[58,247,248],{"class":143},"MTU",[58,250,148],{"class":147},[58,252,253],{"class":211},"1400\n",[58,255,257,260,262],{"class":60,"line":256},9,[58,258,259],{"class":143},"IPADDR",[58,261,148],{"class":147},[58,263,264],{"class":211},"10.244.1.0\n",[58,266,268,271,273],{"class":60,"line":267},10,[58,269,270],{"class":143},"PREFIX",[58,272,148],{"class":147},[58,274,275],{"class":211},"16\n",[17,277,278],{},[20,279,280],{},[23,281,282],{},"WDWD",[284,285,286,293,298,303,315,320,331,340,346,352],"ul",{},[287,288,289,292],"li",{},[36,290,291],{},"NAME=\"YOUR_INTERFACE_NAME\""," - The name of the interface.",[287,294,295,292],{},[36,296,297],{},"DEVICE=\"YOUR_DEVICE_NAME\"",[287,299,300,292],{},[36,301,302],{},"NM_CONTROLLED=\"yes\"",[287,304,305,308,309,311,312,314],{},[36,306,307],{},"ONBOOT=\"INTERFACE_NAME\""," - If ",[36,310,184],{},", the interface is created when the server boots. Should be ",[36,313,184],{}," in most cases.",[287,316,317,292],{},[36,318,319],{},"IPV6INIT=\"INTERFACE_NAME\"",[287,321,322,325,326,330],{},[36,323,324],{},"TYPE=\"OVSBridge\""," - The type of the  interface (see ",[30,327,329],{"href":328},"#OpenVSwitch-related-configuration","OpenVSwitch related configuration"," for more info)",[287,332,333,336,337,339],{},[36,334,335],{},"DEVICETYPE=\"ovs\""," - The device type of the interface (see ",[30,338,329],{"href":328}," for more info).",[287,341,342,345],{},[36,343,344],{},"MTU=YOUR_MTU"," - The MTU of the interface (Only add this option if you know what you are doing).",[287,347,348,351],{},[36,349,350],{},"IPADDR=YOUR_INTERFACE_IP_ADDRESS"," - The name of the created interface.",[287,353,354,351],{},[36,355,356],{},"PREFIX=YOUR_NETWORK_PREFIX",[41,358,329],{"id":359},"openvswitch-related-configuration",[20,361,362],{},"The following options\u002Farguments are important when configuring OpenVSwitch created interfaces:",[284,364,365,377],{},[287,366,367,369,370,372,373,376],{},[36,368,233],{}," - For a bridge interface use ",[36,371,225],{}," and for a port interface use ",[36,374,375],{},"OVSPort",".",[287,378,379,381,382,384],{},[36,380,218],{}," - Always ",[36,383,240],{}," for a OpenVSwitch interface.",[41,386,388],{"id":387},"summary","Summary",[20,390,391,392,395,396,399],{},"That's all you need to do, disable the ",[36,393,394],{},"NetworkManager.service"," and activate the good old ",[36,397,398],{},"network"," service.",[401,402,403],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--s