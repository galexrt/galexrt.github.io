arter\u002F",".",{"title":66,"searchDepth":67,"depth":67,"links":68},"",2,[],"2016-04-30T15:41:02+02:00","SRCDS Server Restarter Script - Automatically restarts freezed\u002Fcrashed SRCDS servers. Using only a Perl script and a Cronjob.","md",{"tags":73},[74,75,76],"Perl","SRCDS Server","Gamserver",true,"\u002Fblog\u002F2016\u002Fsrcds-server-restarter-script",{"title":5,"description":70},"3.blog\u002F2016\u002Fsrcds-server-restarter-script","SBVefBnaCY0xsdi9rb07517n0ZzoltsHm5CjlzDCX5k",[83,88],{"title":84,"path":85,"stem":86,"description":87,"children":-1},"PSA: Keep your computer clean!","\u002Fblog\u002F2016\u002Fpsa-keep-your-computer-clean","3.blog\u002F2016\u002Fpsa-keep-your-computer-clean","Keep your computer(s) clean for them to work even now when a hot summer is around the corner.",{"title":89,"path":90,"stem":91,"description":92,"children":-1},"SteamCMD: Not working on CephFS","\u002Fblog\u002F2016\u002Fsteamcmd-not-working-on-cephfs","3.blog\u002F2016\u002Fsteamcmd-not-working-on-cephfs","A small and uncomplete analysis of why the SteamCMD is not working on CephFS.",[94],{"title":95,"icon":96,"path":97,"stem":98,"children":99},"Docs","i-ph-book-open","\u002Fdocs","1.docs",[100,102,113,153,163,189,213,304,369,377,416,426,494,520,582],{"title":95,"path":97,"stem":101},"1.docs\u002Findex",{"icon":103,"title":104,"path":105,"stem":106,"children":107,"page":112},"i-ph-coffee-bean","Coffee","\u002Fdocs\u002Fcoffee","1.docs\u002Fcoffee",[108],{"title":109,"path":110,"stem":111},"Shops","\u002Fdocs\u002Fcoffee\u002Fshops","1.docs\u002Fcoffee\u002Fshops",false,{"icon":114,"title":115,"path":116,"stem":117,"children":118,"page":112},"i-ph-database","Databases","\u002Fdocs\u002Fdatabases","1.docs\u002Fdatabases",[119,123],{"title":120,"path":121,"stem":122},"MongoDB","\u002Fdocs\u002Fdatabases\u002Fmongodb","1.docs\u002Fdatabases\u002Fmongodb",{"title":124,"icon":125,"path":126,"stem":127,"children":128,"page":112},"MySQL","i-simple-icons-mysql","\u002Fdocs\u002Fda