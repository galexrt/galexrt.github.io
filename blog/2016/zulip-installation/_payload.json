[{"data":1,"prerenderedAt":1059,"buildId":1060},["ShallowReactive",2],{"\u002Fblog\u002F2016\u002Fzulip-installation":3,"\u002Fblog\u002F2016\u002Fzulip-installation-surround":534,"navigation":545},{"id":4,"title":5,"authors":6,"badge":6,"body":7,"date":520,"description":521,"extension":522,"image":523,"meta":525,"navigation":529,"path":530,"seo":531,"stem":532,"__hash__":533},"posts\u002F3.blog\u002F2016\u002Fzulip-installation.md","Zulip: Installation",null,{"type":8,"value":9,"toc":506},"minimark",[10,21,24,29,40,49,53,63,66,96,103,107,110,123,130,149,155,158,217,232,235,239,242,250,259,262,266,269,282,286,292,295,341,344,348,351,370,373,389,398,401,408,434,437,441,444,447,457,460,464,469,472,488,490,494,502],[11,12,13],"blockquote",{},[14,15,16,20],"p",{},[17,18,19],"strong",{},"Please note",": This post is more of a \"draft\" that may not be on my level of post quality.",[14,22,23],{},"Zulip is a powerful open source group chat able to handle multi channel communications. It runs on python.",[25,26,28],"h2",{"id":27},"requirements","Requirements",[14,30,31,32,36,37,39],{},"An Ubuntu Server with at least ",[33,34,35],"code",{},"2GB"," of RAM (",[33,38,35],{}," RAM is currently the recommended amount for a small site).\nMy example server for this tutorial has the following address:",[41,42,43],"ul",{},[44,45,46],"li",{},[33,47,48],{},"203.0.113.1 zulip-tutorial-example",[25,50,52],{"id":51},"preparing-your-server-for-zulip","Preparing your server for Zulip",[11,54,55,60],{},[14,56,57],{},[17,58,59],{},"NOTE",[14,61,62],{},"The current Zulip installation deployment uses one full server! The deployment doesn't care about other services on the server.",[14,64,65],{},"Make sure your server is at the latest version before continuing with the\nTo update all packages on Ubuntu run:",[67,68,73],"pre",{"className":69,"code":70,"language":71,"meta":72,"style":72},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","apt-get update\napt-get upgrade\n","bash","",[33,74,75,88],{"__ignoreMap":72},[76,77,80,84],"span",{"class":78,"line":79},"line",1,[76,81,83],{"class":82},"sBMFI","apt-get",[76,85,87],{"class":86},"sfazB"," update\n",[76,89,91,93],{"class":78,"line":90},2,[76,92,83],{"class":82},[76,94,95],{"class":86}," upgrade\n",[14,97,98,99,102],{},"Confirm with (depending on the system locale) with ",[33,100,101],{},"y",".`",[25,104,106],{"id":105},"step-1-downloading-zulip","Step 1 - Downloading Zulip",[14,108,109],{},"Please login as root user.\nOn most Ubuntu systems, you would use",[67,111,113],{"className":69,"code":112,"language":71,"meta":72,"style":72},"sudo -i\n",[33,114,115],{"__ignoreMap":72},[76,116,117,120],{"class":78,"line":79},[76,118,119],{"class":82},"sudo",[76,121,122],{"class":86}," -i\n",[14,124,125,126,129],{},"to switch to the root user.\nNext up we make sure that we are in the root user's home directory ",[33,127,128],{},"\u002Froot",".",[67,131,133],{"className":69,"code":132,"language":71,"meta":72,"style":72},"cd \u002Froot\npwd\n",[33,134,135,144],{"__ignoreMap":72},[76,136,137,141],{"class":78,"line":79},[76,138,140],{"class":139},"s2Zo4","cd",[76,142,143],{"class":86}," \u002Froot\n",[76,145,146],{"class":78,"line":90},[76,147,148],{"class":139},"pwd\n",[14,150,151,154],{},[33,152,153],{},"pwd"," prints the current working directoy.",[14,156,157],{},"For the latest Zulip version the download and extraction commands are:",[67,159,161],{"className":69,"code":160,"language":71,"meta":72,"style":72},"cd \u002Froot\nwget https:\u002F\u002Fwww.zulip.com\u002Fdist\u002Freleases\u002Fzulip-server-latest.tar.gz\nrm -rf \u002Froot\u002Fzulip && mkdir \u002Froot\u002Fzulip\ntar -xf zulip-server-latest.tar.gz --directory=\u002Froot\u002Fzulip --strip-components=1\n",[33,162,163,169,177,199],{"__ignoreMap":72},[76,164,165,167],{"class":78,"line":79},[76,166,140],{"class":139},[76,168,143],{"class":86},[76,170,171,174],{"class":78,"line":90},[76,172,173],{"class":82},"wget",[76,175,176],{"class":86}," https:\u002F\u002Fwww.zulip.com\u002Fdist\u002Freleases\u002Fzulip-server-latest.tar.gz\n",[76,178,180,183,186,189,193,196],{"class":78,"line":179},3,[76,181,182],{"class":82},"rm",[76,184,185],{"class":86}," -rf",[76,187,188],{"class":86}," \u002Froot\u002Fzulip",[76,190,192],{"class":191},"sMK4o"," &&",[76,194,195],{"class":82}," mkdir",[76,197,198],{"class":86}," \u002Froot\u002Fzulip\n",[76,200,202,205,208,211,214],{"class":78,"line":201},4,[76,203,204],{"class":82},"tar",[76,206,207],{"class":86}," -xf",[76,209,210],{"class":86}," zulip-server-latest.tar.gz",[76,212,213],{"class":86}," --directory=\u002Froot\u002Fzulip",[76,215,216],{"class":86}," --strip-components=1\n",[11,218,219,223],{},[14,220,221],{},[17,222,59],{},[14,224,225,226,228,229,231],{},"You need to have ",[33,227,204],{}," and ",[33,230,173],{}," installed on the server. On most servers these tools are already installed.",[14,233,234],{},"Now that we have Zulip downloaded, we can continue to the next step.",[25,236,238],{"id":237},"step-2-install-zulip","Step 2 - Install Zulip",[14,240,241],{},"With the following command, we start the Zulip installation.",[11,243,244],{},[14,245,246,249],{},[17,247,248],{},"!! WARNING !!"," This will install Zulip to your server and if other applications are also running on this server it can completely mess them up, as mentioned earlier!",[67,251,253],{"className":69,"code":252,"language":71,"meta":72,"style":72},"\u002Froot\u002Fzulip\u002Fscripts\u002Fsetup\u002Finstall\n",[33,254,255],{"__ignoreMap":72},[76,256,257],{"class":78,"line":79},[76,258,252],{"class":82},[14,260,261],{},"The command may take some to complete. The command installs Zulip's dependencies and Zulip itself on the server.",[25,263,265],{"id":264},"step-3-checking-the-zulip-installation","Step 3 - Checking the Zulip installation",[14,267,268],{},"Navigate to the bottom of the file and check that it reports the success of the installation.\nThe command for opening the installation log file in a \"paginator\" is:",[67,270,272],{"className":69,"code":271,"language":71,"meta":72,"style":72},"less \u002Fvar\u002Flog\u002Fzulip\u002Finstall.log\n",[33,273,274],{"__ignoreMap":72},[76,275,276,279],{"class":78,"line":79},[76,277,278],{"class":82},"less",[76,280,281],{"class":86}," \u002Fvar\u002Flog\u002Fzulip\u002Finstall.log\n",[25,283,285],{"id":284},"step-4-configuring-the-zulip-instance","Step 4 - Configuring the Zulip instance",[14,287,288,289,129],{},"For Zulip to function you need to set some mandatory settings.\nZulip's config file is located at ",[33,290,291],{},"\u002Fetc\u002Fzulip\u002Fsettings.py",[14,293,294],{},"The following list contains the mandatory settings.",[41,296,297,303,309,314,320,326,332],{},[44,298,299,302],{},[33,300,301],{},"EXTERNAL_HOST"," should be your external address.",[44,304,305,308],{},[33,306,307],{},"ZULIP_ADMINISTRATOR"," the email of the administrator that will be also shown as the contact email address.",[44,310,311],{},[33,312,313],{},"AUTHENTICATION_BACKENDS",[44,315,316,319],{},[33,317,318],{},"EMAIL_*"," the email server settings, please look at the comments in the file for more information about the variables.",[44,321,322,325],{},[33,323,324],{},"DEFAULT_FROM_EMAIL"," the default sender email address used for the outgoing email traffic.",[44,327,328,331],{},[33,329,330],{},"NOREPLY_EMAIL_ADDRESS"," the address for noreply in the outgoing email traffic.",[44,333,334,337,338,129],{},[33,335,336],{},"ALLOWED_HOSTS"," the fully qualified DNS name of the server you installed Zulip on or just set it to ",[33,339,340],{},"*",[14,342,343],{},"The config file contains a comment above all the variables.\nGo ahead and configure the mandatory values to your needs.",[25,345,347],{"id":346},"step-5-preparing-the-zulip-instance-for-usage","Step 5 - Preparing the Zulip instance for usage",[14,349,350],{},"Now that you have Zulip configured, we can now initialize the database.",[67,352,354],{"className":69,"code":353,"language":71,"meta":72,"style":72},"su zulip -c \u002Fhome\u002Fzulip\u002Fdeployments\u002Fcurrent\u002Fscripts\u002Fsetup\u002Finitialize-database\n",[33,355,356],{"__ignoreMap":72},[76,357,358,361,364,367],{"class":78,"line":79},[76,359,360],{"class":82},"su",[76,362,363],{"class":86}," zulip",[76,365,366],{"class":86}," -c",[76,368,369],{"class":86}," \u002Fhome\u002Fzulip\u002Fdeployments\u002Fcurrent\u002Fscripts\u002Fsetup\u002Finitialize-database\n",[14,371,372],{},"After the database initialization has successfully completed, we should now you should verify that your Zulip email settings are correct:",[67,374,376],{"className":69,"code":375,"language":71,"meta":72,"style":72},".\u002Fmanage.py send_test_email YOUR_EMAIL_ADDRESS\n",[33,377,378],{"__ignoreMap":72},[76,379,380,383,386],{"class":78,"line":79},[76,381,382],{"class":82},".\u002Fmanage.py",[76,384,385],{"class":86}," send_test_email",[76,387,388],{"class":86}," YOUR_EMAIL_ADDRESS\n",[11,390,391,395],{},[14,392,393],{},[17,394,59],{},[14,396,397],{},"Replace the placeholders with your own values.",[14,399,400],{},"The command above will send a test email to the specified email address, please make sure the email successfully arrives.\nIf it's not in the inbox make sure to also check your SPAM folder.",[14,402,403,404,407],{},"We need a Zulip organistation for your users.\nFor that we need to switch to the ",[33,405,406],{},"zulip"," user, switch into the current Zulip installation and create a link for realm generation with the command:",[67,409,411],{"className":69,"code":410,"language":71,"meta":72,"style":72},"su zulip\ncd \u002Fhome\u002Fzulip\u002Fdeployments\u002Fcurrent\n.\u002Fmanage.py generate_realm_creation_link\n",[33,412,413,420,427],{"__ignoreMap":72},[76,414,415,417],{"class":78,"line":79},[76,416,360],{"class":82},[76,418,419],{"class":86}," zulip\n",[76,421,422,424],{"class":78,"line":90},[76,423,140],{"class":139},[76,425,426],{"class":86}," \u002Fhome\u002Fzulip\u002Fdeployments\u002Fcurrent\n",[76,428,429,431],{"class":78,"line":179},[76,430,382],{"class":82},[76,432,433],{"class":86}," generate_realm_creation_link\n",[14,435,436],{},"Go to the link the last command outputs and you will be prompted with a form for an account and realm creation.\nA realm is like an organization.",[25,438,440],{"id":439},"step-6-using-your-zulip-instance","Step 6 - Using your Zulip instance",[14,442,443],{},"Now just navigate to your Zulip instance and if you need to login go ahead.",[14,445,446],{},"You now have a working Zulip instance!",[14,448,449,450,129],{},"If you want to read more about configuration and the integration possibilities you can go to the official documentation of Zulip.\nSee ",[451,452,456],"a",{"href":453,"rel":454},"https:\u002F\u002Fzulip.readthedocs.io\u002Fen\u002Flatest\u002Findex.html",[455],"nofollow","Zulip Official Documentation",[458,459],"hr",{},[25,461,463],{"id":462},"tips-and-tricks","Tips and Tricks",[465,466,468],"h3",{"id":467},"restarting-zulip","Restarting Zulip",[14,470,471],{},"Use the below command to restart your Zulip instance, after making changes to the config:",[67,473,475],{"className":69,"code":474,"language":71,"meta":72,"style":72},"su zulip -c \u002Fhome\u002Fzulip\u002Fdeployments\u002Fcurrent\u002Fscripts\u002Frestart-server\n",[33,476,477],{"__ignoreMap":72},[76,478,479,481,483,485],{"class":78,"line":79},[76,480,360],{"class":82},[76,482,363],{"class":86},[76,484,366],{"class":86},[76,486,487],{"class":86}," \u002Fhome\u002Fzulip\u002Fdeployments\u002Fcurrent\u002Fscripts\u002Frestart-server\n",[458,489],{},[25,491,493],{"id":492},"troubleshooting","Troubleshooting",[14,495,496,497,129],{},"A good guide for troubleshooting can be found on the official documentation of Zulip ",[451,498,501],{"href":499,"rel":500},"https:\u002F\u002Fzulip.readthedocs.io\u002Fen\u002Flatest\u002Fprod-troubleshooting.html",[455],"here",[503,504,505],"style",{},"html pre.shiki code .sBMFI, html code