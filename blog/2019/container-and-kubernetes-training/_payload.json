[{"data":1,"prerenderedAt":652,"buildId":653},["ShallowReactive",2],{"\u002Fblog\u002F2019\u002Fcontainer-and-kubernetes-training":3,"\u002Fblog\u002F2019\u002Fcontainer-and-kubernetes-training-surround":128,"navigation":138},{"id":4,"title":5,"authors":6,"badge":12,"body":13,"date":113,"description":114,"extension":115,"image":116,"meta":118,"navigation":123,"path":124,"seo":125,"stem":126,"__hash__":127},"posts\u002F3.blog\u002F2019\u002Fcontainer-and-kubernetes-training.md","Container and Kubernetes Training",[7],{"name":8,"to":9,"avatar":10},"Alexander Trost","https:\u002F\u002Fgithub.com\u002Fgalexrt",{"src":11},"\u002Fimages\u002Fprofile-picture.webp",null,{"type":14,"value":15,"toc":106},"minimark",[16,21,25,29,45,48,52,55,58,66,75,77,103],[17,18,20],"h2",{"id":19},"welcome","Welcome!",[22,23,24],"p",{},"Quick short introduction to myself, my name is Alexander Trost. I’m a sysadmin who loves automation, containers, coding in Go, playing games but also with new technologies.\nI'm currently working at Cloudical as a DevOps Engineer, helping companies move to the cloud and\u002F or to container technologies (e.g., Docker, Kubernetes, etc).",[17,26,28],{"id":27},"goal-of-the-training","Goal of the Training",[22,30,31,32,39,40,44],{},"The training is going to show how simple it is to get started with containers. In this case ",[33,34,38],"a",{"href":35,"rel":36},"https:\u002F\u002Fwww.docker.com\u002F",[37],"nofollow","Docker"," is used, as it is the most popular container toolchain and runtime right now.\nAfter getting to know containers and Docker, we will hopefully realize that there is a need for some kind of ",[41,42,43],"em",{},"magical"," orchestration layer to run applications and more in containers (in an orchestrated way). The important if you haven't noticed here is the orchestration of containers in an automated and orchestrated manner.",[46,47],"hr",{},[17,49,51],{"id":50},"material-for-the-training","Material for the training",[22,53,54],{},"The material for the training has been taken \"offline\" to revise it but also due to the amount of time that is put into the whole of the material. I hope you understand!",[22,56,57],{},"Should you have attended the training and have not received the material in form of PDFs yet, please contact me by email, thanks!",[22,59,60,61,65],{},"(You can get my email address by using the email icon in the sidebar or the ",[33,62,64],{"href":63},"\u002Fabout","About page",")",[22,67,68,69,74],{},"The repository with some example files remains public, see ",[33,70,73],{"href":71,"rel":72},"https:\u002F\u002Fgithub.com\u002Fgalexrt\u002Fworkshop-container-docker-kubernetes",[37],"GitHub galexrt\u002Fworkshop-container-docker-kubernetes repository",".",[46,76],{},[22,78,79,80,85,86,91,92,97,98,102],{},"A thanks to ",[33,81,84],{"href":82,"rel":83},"https:\u002F\u002Ftwitter.com\u002Ffpfka",[37],"Felix Pfefferkorn (@fpfka)"," for asking me to hold this training at ",[33,87,90],{"href":88,"rel":89},"https:\u002F\u002Fffg.guug.de\u002F",[37],"GUUG-Frühjahrsfachgespräch 2019"," and being an awesome training officer (Ausbildungsleiter) at ",[33,93,96],{"href":94,"rel":95},"https:\u002F\u002Fjobs.1und1.de\u002F",[37],"1&1",".\nAnother thanks to ",[33,99,101],{"href":88,"rel":100},[37],"GUUG-Frühjahrsfachgespräch 2019 team"," for having me there for this trainings at their conference!",[22,104,105],{},"Have Fun!",{"title":107,"searchDepth":108,"depth":108,"links":109},"",2,[110,111,112],{"id":19,"depth":108,"text":20},{"id":27,"depth":108,"text":28},{"id":50,"depth":108,"text":51},"2019-03-26T22:20:06+01:00","Container und Kubernetes Training Material","md",{"src":117},"\u002Fblog\u002Fcovers\u002Fdocker-logo-vertical.png",{"tags":119},[120,38,121,122],"Workshop","Kubernetes","Container",true,"\u002Fblog\u002F2019\u002Fcontainer-and-kubernetes-training",{"title":5,"description":114},"3.blog\u002F2019\u002Fcontainer-and-kubernetes-training","IDbam6cCKoEmR0yrTWes2Y64k51-yf6PFhZ4p-A_yz8",[129,13