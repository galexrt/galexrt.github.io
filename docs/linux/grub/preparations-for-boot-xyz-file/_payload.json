[{"data":1,"prerenderedAt":773,"buildId":774},["ShallowReactive",2],{"\u002Fdocs\u002Flinux\u002Fgrub\u002Fpreparations-for-boot-xyz-file":3,"\u002Fdocs\u002Flinux\u002Fgrub\u002Fpreparations-for-boot-xyz-file-surround":258,"navigation":267},{"id":4,"title":5,"body":6,"description":162,"extension":251,"meta":252,"navigation":253,"path":254,"seo":255,"stem":256,"__hash__":257},"docs\u002F1.docs\u002Flinux\u002Fgrub\u002Fpreparations-for-boot-xyz-file.md","Preparations for 'Booting XYZ FIle'",{"type":7,"value":8,"toc":248},"minimark",[9,33,36,46,53,215,218,244],[10,11,13,21],"callout",{"icon":12},"i-ph-lightbulb-filament",[14,15,16,20],"p",{},[17,18,19],"strong",{},"Danger",":\nOnly run the following commands if you know what they are doing!",[14,22,23,24,28,29,32],{},"If you already have GRUB installed and working, you probably just need to edit your ",[25,26,27],"code",{},"grub.cfg"," file (for most OSes in the ",[25,30,31],{},"\u002Fboot"," directory).",[14,34,35],{},"The disk to be used should be:",[37,38,39,43],"ul",{},[40,41,42],"li",{},"Boot Target in BIOS\u002F UEFI",[40,44,45],{},"First in the BIOS\u002F UEFI boot order",[14,47,48,49,52],{},"The disk used in this example is ",[25,50,51],{},"\u002Fdev\u002Fsda",".",[54,55,56,107,122,148,198],"ol",{},[40,57,58,59],{},"Prepare Disk partition layout",[37,60,61,91],{},[40,62,63,64,67,68,71,72],{},"Create two partitions on the disk (use, e.g., ",[25,65,66],{},"fdisk",", ",[25,69,70],{},"parted",", etc)\n",[37,73,74,81],{},[40,75,76,77,80],{},"1MB  (flags: ",[25,78,79],{},"boot",")",[40,82,83,84,86,87,90],{},"10G or more as you want\u002F need (flags: ",[25,85,79],{},"), ",[25,88,89],{},"ext4"," formatted",[40,92,93,94,97,98],{},"Run ",[25,95,96],{},"blkid \u002Fdev\u002Fsda2 -s UUID -o value"," to get the UUID of the \"first\" disk's second partition.\n",[37,99,100],{},[40,101,102,103,106],{},"Save the UUID of the \"first\" disk down. The UUID of the \"first\" disk will be used in form of the ",[25,104,105],{},"__BOOT_PART_UUID__"," later on.",[40,108,109,110],{},"Mount \"boot\" Partition",[37,111,112],{},[40,113,114,115,118,119,52],{},"Mount the second created partition (",[25,116,117],{},"\u002Fdev\u002Fsda2","): ",[25,120,121],{},"mount \u002Fdev\u002Fsda2 \u002Fboot",[40,123,124,125,67,128,131,132,135,136,138,139],{},"Download Fedora ",[25,126,127],{},"vmlinuz",[25,129,130],{},"initramfs"," and ",[25,133,134],{},"install.img"," to ",[25,137,31],{}," directory.",[37,140,141],{},[40,142,143,144,147],{},"Prefix the downloaded files with ",[25,145,146],{},"fedora-"," (or whatever you want as long as you change it in the upcoming steps as well)",[40,149,150,151],{},"Grub Installation",[37,152,153,181],{},[40,154,155,156],{},"For GRUB2:",[157,158,163],"pre",{"className":159,"code":160,"language":161,"meta":162,"style":162},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","grub2-install --no-floppy \u002Fdev\u002Fsda2\n","bash","",[25,164,165],{"__ignoreMap":162},[166,167,170,174,178],"span",{"class":168,"line":169},"line",1,[166,171,173],{"class":172},"sBMFI","grub2-install",[166,175,177],{"class":176},"sfazB"," --no-floppy",[166,179,180],{"class":176}," \u002Fdev\u002Fsda2\n",[40,182,183,184],{},"For GRUB:",[157,185,187],{"className":159,"code":186,"language":161,"meta":162,"style":162},"grub-install --no-floppy \u002Fdev\u002Fsda2\n",[25,188,189],{"__ignoreMap":162},[166,190,191,194,196],{"class":168,"line":169},[166,192,193],{"class":172},"grub-install",[166,195,177],{"class":176},[166,197,180],{"class":176},[40,199,200,201],{},"Create GRUB boot config file",[37,202,203,209],{},[40,204,205,206,52],{},"For GRUB2 the path is ",[25,207,208],{},"\u002Fboot\u002Fgrub2\u002Fgrub.cfg",[40,210,211,212,52],{},"For GRUB the path is ",[25,213,214],{},"\u002Fboot\u002Fgrub\u002Fgrub.cfg",[14,216,217],{},"Optional steps:",[54,219,220,241],{},[40,221,222,223,225,226],{},"Copy your Kickstart and\u002F or config file to the ",[25,224,31],{}," directory\n",[37,227,228],{},[40,229,230,231,233,234,237,238,240],{},"This assumes the \"system\" you are using is able to open the ",[25,232,31],{}," mounted partition and read the file from there, e.g., Kickstart can do it like that ",[25,235,236],{},"inst.ks=\"hd:UUID=__BOOT_PART_UUID__:\u002Fks.cfg\""," (where the ",[25,239,105],{}," is the partition UUID).",[40,242,243],{},"Reboot and enjoy!",[245,246,247],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-deco