nuxt",[504],{"title":505,"path":506,"stem":507},"Loading Indicator","\u002Fdocs\u002Fweb\u002Fnuxt\u002Floading-indicator","1.docs\u002Fweb\u002Fnuxt\u002Floading-indicator",{"title":509,"icon":510,"path":511,"stem":512,"children":513,"page":22},"Tiptap","i-mdi-file-edit-outline","\u002Fdocs\u002Fweb\u002Ftiptap","1.docs\u002Fweb\u002Ftiptap",[514],{"title":515,"path":516,"stem":517},"Snippets","\u002Fdocs\u002Fweb\u002Ftiptap\u002Fsnippets","1.docs\u002Fweb\u002Ftiptap\u002Fsnippets",{"id":519,"title":443,"body":520,"description":526,"extension":1622,"meta":1623,"navigation":666,"path":444,"seo":1625,"stem":445,"__hash__":1626},"docs\u002F1.docs\u002Fstorage\u002Fceph\u002Farchitecture.md",{"type":521,"value":522,"toc":1605},"minimark",[523,527,532,567,572,722,726,730,738,741,814,826,831,834,904,913,917,928,931,1001,1004,1012,1016,1019,1196,1213,1221,1225,1228,1231,1349,1357,1361,1364,1437,1440,1527,1535,1538,1552,1554,1558,1567,1571,1578,1582,1585,1591,1595,1601],[524,525,526],"p",{},"Ceph offers block storage (RBD), network filesystem (CephFS), object storage (RGW, S3, SWIFT) and key value storage (librados).",[528,529,531],"h2",{"id":530},"glossary","Glossary",[533,534,535,553],"ul",{},[536,537,538,539],"li",{},"Daemons\n",[533,540,541,544,547,550],{},[536,542,543],{},"MON: Monitor Daemon",[536,545,546],{},"MGR: Manager Daemon",[536,548,549],{},"OSD: Object Storage Daemon",[536,551,552],{},"RGW: Rados Gateway",[536,554,555,556],{},"\"Things\"\n",[533,557,558,561,564],{},[536,559,560],{},"Pool: Group of PGs, separation .",[536,562,563],{},"PG: Placement Group, group of objects in a pool.",[536,565,566],{},"Object: A single object \"somewhere in the cluster\". Part of a PG.",[568,569,571],"h3",{"id":570},"pool-pg-object","Pool -> PG -> Object",[573,574,575],"mermaid",{},[576,577,581],"pre",{"className":578,"code":579,"language":573,"meta":580,"style":580},"language-mermaid shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","graph LR\nsubgraph Pool\n    subgraph PG-2[PG 2]\n        Object-1[Object 1]\n        Object-2[Object 2]\n    end\n\n    subgraph PG-1[PG 1]\n        Object-3[Object 3]\n        Object-4[Object 4]\n    end\nend\n","",[582,583,584,597,606,629,642,655,661,668,685,698,711,716],"code",{"__ignoreMap":580},[585,586,589,593],"span",{"class":587,"line":588},"line",1,[585,590,592],{"class":591},"s7zQu","graph",[585,594,596],{"class":595},"s2Zo4"," LR\n",[585,598,600,603],{"class":587,"line":599},2,[585,601,602],{"class":591},"subgraph",[585,604,605],{"class":595}," Pool\n",[585,607,609,612,615,619,622,626],{"class":587,"line":608},3,[585,610,611],{"class":591},"    subgraph",[585,613,614],{"class":595}," PG",[585,616,618],{"class":617},"sTEyZ","-2",[585,620,621],{"class":591},"[",[585,623,625],{"class":624},"sfazB","PG 2",[585,627,628],{"class":591},"]\n",[585,630,632,635,637,640],{"class":587,"line":631},4,[585,633,634],{"class":617},"        Object-1",[585,636,621],{"class":591},[585,638,639],{"class":624},"Object 1",[585,641,628],{"class":591},[585,643,645,648,650,653],{"class":587,"line":644},5,[585,646,647],{"class":617},"        Object-2",[585,649,621],{"class":591},[585,651,652],{"class":624},"Object 2",[585,654,628],{"class":591},[585,656,658],{"class":587,"line":657},6,[585,659,660],{"class":591},"    end\n",[585,662,664],{"class":587,"line":663},7,[585,665,667],{"emptyLinePlaceholder":666},true,"\n",[585,669,671,673,675,678,680,683],{"class":587,"line":670},8,[585,672,611],{"class":591},[585,674,614],{"class":595},[585,676,677],{"class":617},"-1",[585,679,621],{"class":591},[585,681,682],{"class":624},"PG 1",[585,684,628],{"class":591},[585,686,688,691,693,696],{"class":587,"line":687},9,[585,689,690],{"class":617},"        Object-3",[585,692,621],{"class":591},[585,694,695],{"class":624},"Object 3",[585,697,628],{"class":591},[585,699,701,704,706,709],{"class":587,"line":700},10,[585,702,703],{"class":617},"        Object-4",[585,705,621],{"class":591},[585,707,708],{"class":624},"Object 4",[585,710,628],{"class":591},[585,712,714],{"class":587,"line":713},11,[585,715,660],{"class":591},[585,717,719],{"class":587,"line":718},12,[585,720,721],{"class":591},"end\n",[528,723,725],{"id":724},"ceph-cluster-components","Ceph Cluster Components",[568,727,729],{"id":728},"mon-monitor-daemon","MON - Monitor Daemon",[524,731,732,733,737],{},"The MONs are keeping a ",[734,735,736],"strong",{},"map"," of the current MONs, OSDs, PGs, Pools and so on.",[524,739,740],{},"MONs require a quorum to function, meaning that you should always run at least 3 mons for production 5 can be a good idea as well.",[573,742,743],{},[576,744,746],{"className":578,"code":745,"language":573,"meta":580,"style":580},"graph LR\n    MON-A[\"MON A\"]\n    MON-B[\"MON B\"]\n    MON-C[\"MON C\"]\n\n    MON-A -.- MON-B\n    MON-A -.- MON-C\n",[582,747,748,754,766,778,790,794,805],{"__ignoreMap":580},[585,749,750,752],{"class":587,"line":588},[585,751,592],{"class":591},[585,753,596],{"class":595},[585,755,756,759,761,764],{"class":587,"line":599},[585,757,758],{"class":617},"    MON-A",[585,760,621],{"class":591},[585,762,763],{"class":624},"\"MON A\"",[585,765,628],{"class":591},[585,767,768,771,773,776],{"class":587,"line":608},[585,769,770],{"class":617},"    MON-B",[585,772,621],{"class":591},[585,774,775],{"class":624},"\"MON B\"",[585,777,628],{"class":591},[585,779,780,783,785,788],{"class":587,"line":631},[585,781,782],{"class":617},"    MON-C",[585,784,621],{"class":591},[585,786,787],{"class":624},"\"MON C\"",[585,789,628],{"class":591},[585,791,792],{"class":587,"line":644},[585,793,667],{"emptyLinePlaceholder":666},[585,795,796,799,802],{"class":587,"line":657},[585,797,798],{"class":617},"    MON-A ",[585,800,801],{"class":591},"-.-",[585,803,804],{"class":617}," MON-B\n",[585,806,807,809,811],{"class":587,"line":663},[585,808,798],{"class":617},[585,810,801],{"class":591},[585,812,813],{"class":617}," MON-C\n",[524,815,816,819,820],{},[734,817,818],{},"Man Page",": ",[821,822,823],"a",{"href":823,"rel":824},"https:\u002F\u002Fdocs.ceph.com\u002Fen\u002Flatest\u002Fman\u002F8\u002Fceph-mon\u002F",[825],"nofollow",[827,828,830],"h4",{"id":829},"quorum","Quorum",[524,832,833],{},"Simply put, if you run with 3 MONs you can lose 1 MON before the cluster will come to a halt as the quorum would be lost.",[835,836,837,850],"table",{},[838,839,840],"thead",{},[841,842,843,847],"tr",{},[844,845,846],"th",{},"MONs",[844,848,849],{},"How many can be lost?",[851,852,853,862,869,876,883,890,897],"tbody",{},[841,854,855,859],{},[856,857,858],"td",{},"1",[856,860,861],{},"0",[841,863,864,867],{},[856,865,866],{},"2",[856,868,861],{},[841,870,871,874],{},[856,872,873],{},"3",[856,875,858],{},[841,877,878,881],{},[856,879,880],{},"4",[856,882,858],{},[841,884,885,888],{},[856,886,887],{},"5",[856,889,866],{},[841,891,892,895],{},[856,893,894],{},"6",[856,896,866],{},[841,898,899,902],{},[856,900,901],{},"7",[856,903,873],{},[524,905,906,907,912],{},"For more information regarding quorum, checkout the following link from the ETCD documentation: ",[821,908,911],{"href":909,"rel":910},"https:\u002F\u002Fetcd.io\u002Fdocs\u002Fv3.3\u002Ffaq\u002F#why-an-odd-number-of-cluster-members",[825],"ETCD v3.3. - FAQ Why an odd number of cluster members?",".\nETCD is a good example of an infrastructure critical application (for Kubernetes) which requires a Quorum for (most; depending on your settings) operations.",[568,914,916],{"id":915},"mgr-manager-daemon","MGR - Manager Daemon",[524,918,919,920,923,924,927],{},"The MGR daemon(s) \"provide additional monitoring and interfaces to external monitoring and management systems\". You need to have at least one running as otherwise certain status information in, e.g., ",[582,921,922],{},"ceph status"," (",[582,925,926],{},"ceph -s","), will not be shown.\nIt is recommended to run at least 1.",[524,929,930],{},"The MGR daemon(s) talk with the MON, OSD MDS, and even RGW.",[573,932,933],{},[576,934,936],{"className":578,"code":935,"language":573,"meta":580,"style":580},"---\nconfig:\n  layout: elk\n---\ngraph LR\n    MGR --> MON\n    MGR --> OSD\n    MGR --> MDS\n    MGR --> RGW\n",[582,937,938,943,948,953,957,963,974,983,992],{"__ignoreMap":580},[585,939,940],{"class":587,"line":588},[585,941,942],{"class":617},"---\n",[585,944,945],{"class":587,"line":599},[585,946,947],{"class":617},"config:\n",[585,949,950],{"class":587,"line":608},[585,951,952],{"class":617},"  layout: elk\n",[585,954,955],{"class":587,"line":631},[585,956,942],{"class":617},[585,958,959,961],{"class":587,"line":644},[585,960,592],{"class":591},[585,962,596],{"class":595},[585,964,965,968,971],{"class":587,"line":657},[585,966,967],{"class":617},"    MGR ",[585,969,970],{"class":591},"-->",[585,972,973],{"class":617}," MON\n",[585,975,976,978,980],{"class":587,"line":663},[585,977,967],{"class":617},[585,979,970],{"class":591},[585,981,982],{"class":617}," OSD\n",[585,984,985,987,989],{"class":587,"line":670},[585,986,967],{"class":617},[585,988,970],{"class":591},[585,990,991],{"class":617}," MDS\n",[585,993,994,996,998],{"class":587,"line":687},[585,995,967],{"class":617},[585,997,970],{"class":591},[585,999,1000],{"class":617}," RGW\n",[524,1002,1003],{},"The MGR daemon(s) have many modules to for example provide metrics for Prometheus, Zabbix and others. In addition to that a Ceph dashboard can be activated which contains some basic information and even an integration with Prometheus and Grafana.",[524,1005,1006,819,1008],{},[734,1007,818],{},[821,1009,1010],{"href":1010,"rel":1011},"https:\u002F\u002Fdocs.ceph.com\u002Fen\u002Flatest\u002Fmgr\u002Findex.html",[825],[568,1013,1015],{"id":1014},"osd-object-storage-daemon","OSD - Object Storage Daemon",[524,1017,1018],{},"All OSDs normally talk with each other for hearbeat ❤️ checking and data replication (actual data and also for data \"scrubbing\" operations).",[573,1020,1021],{},[576,1022,1024],{"className":578,"code":1023,"language":573,"meta":580,"style":580},"---\nconfig:\n  layout: elk\n---\ngraph LR\n    OSD-0\n    OSD-0 -.- OSD-1\n    OSD-0 -.- OSD-2\n    OSD-0 -.- OSD-n\n\n    OSD-1\n    OSD-1 -.- OSD-0\n    OSD-1 -.- OSD-2\n    OSD-1 -.- OSD-n\n\n    OSD-2\n    OSD-2 -.- OSD-0\n    OSD-2 -.- OSD-1\n    OSD-2 -.- OSD-n\n\n    OSD-n\n    OSD-n -.- OSD-0\n    OSD-n -.- OSD-1\n    OSD-n -.- OSD-2\n",[582,1025,1026,1030,1034,1038,1042,1048,1053,1063,1072,1081,1085,1090,1100,1109,1118,1123,1129,1139,1148,1157,1162,1168,1178,1187],{"__ignoreMap":580},[585,1027,1028],{"class":587,"line":588},[585,1029,942],{"class":617},[585,1031,1032],{"class":587,"line":599},[585,1033,947],{"class":617},[585,1035,1036],{"class":587,"line":608},[585,1037,952],{"class":617},[585,1039,1040],{"class":587,"line":631},[585,1041,942],{"class":617},[585,1043,1044,1046],{"class":587,"line":644},[585,1045,592],{"class":591},[585,1047,596],{"class":595},[585,1049,1050],{"class":587,"line":657},[585,1051,1052],{"class":617},"    OSD-0\n",[585,1054,1055,1058,1060],{"class":587,"line":663},[585,1056,1057],{"class":617},"    OSD-0 ",[585,1059,801],{"class":591},[585,1061,1062],{"class":617}," OSD-1\n",[585,1064,1065,1067,1069],{"class":587,"line":670},[585,1066,1057],{"class":617},[585,1068,801],{"class":591},[585,1070,1071],{"class":617}," OSD-2\n",[585,1073,1074,1076,1078],{"class":587,"line":687},[585,1075,1057],{"class":617},[585,1077,801],{"class":591},[585,1079,1080],{"class":617}," OSD-n\n",[585,1082,1083],{"class":587,"line":700},[585,1084,667],{"emptyLinePlaceholder":666},[585,1086,1087],{"class":587,"line":713},[585,1088,1089],{"class":617},"    OSD-1\n",[585,1091,1092,1095,1097],{"class":587,"line":718},[585,1093,1094],{"class":617},"    OSD-1 ",[585,1096,801],{"class":591},[585,1098,1099],{"class":617}," OSD-0\n",[585,1101,1103,1105,1107],{"class":587,"line":1102},13,[585,1104,1094],{"class":617},[585,1106,801],{"class":591},[585,1108,1071],{"class":617},[585,1110,1112,1114,1116],{"class":587,"line":1111},14,[585,1113,1094],{"class":617},[585,1115,801],{"class":591},[585,1117,1080],{"class":617},[585,1119,1121],{"class":587,"line":1120},15,[585,1122,667],{"emptyLinePlaceholder":666},[585,1124,1126],{"class":587,"line":1125},16,[585,1127,1128],{"class":617},"    OSD-2\n",[585,1130,1132,1135,1137],{"class":587,"line":1131},17,[585,1133,1134],{"class":617},"    OSD-2 ",[585,1136,801],{"class":591},[585,1138,1099],{"class":617},[585,1140,1142,1144,1146],{"class":587,"line":1141},18,[585,1143,1134],{"class":617},[585,1145,801],{"class":591},[585,1147,1062],{"class":617},[585,1149,1151,1153,1155],{"class":587,"line":1150},19,[585,1152,1134],{"class":617},[585,1154,801],{"class":591},[585,1156,1080],{"class":617},[585,1158,1160],{"class":587,"line":1159},20,[585,1161,667],{"emptyLinePlaceholder":666},[585,1163,1165],{"class":587,"line":1164},21,[585,1166,1167],{"class":617},"    OSD-n\n",[585,1169,1171,1174,1176],{"class":587,"line":1170},22,[585,1172,1173],{"class":617},"    OSD-n ",[585,1175,801],{"class":591},[585,1177,1099],{"class":617},[585,1179,1181,1183,1185],{"class":587,"line":1180},23,[585,1182,1173],{"class":617},[585,1184,801],{"class":591},[585,1186,1062],{"class":617},[585,1188,1190,1192,1194],{"class":587,"line":1189},24,[585,1191,1173],{"class":617},[585,1193,801],{"class":591},[585,1195,1071],{"class":617},[533,1197,1198,1201,1204],{},[536,1199,1200],{},"If a client writes data, the data is replicated by the OSD and not the client.",[536,1202,1203],{},"If a client reads data, the data can be read from multiple OSDs at the same time (as long as they have a replica of the data).",[536,1205,1206,819,1209],{},[734,1207,1208],{},"Side note",[1210,1211,1212],"em",{},"That is the reason why read speeds are so fast and writes can be so slow. One slow OSD can \"ruin your day\" because of that.",[524,1214,1215,819,1217],{},[734,1216,818],{},[821,1218,1219],{"href":1219,"rel":1220},"https:\u002F\u002Fdocs.ceph.com\u002Fen\u002Flatest\u002Fman\u002F8\u002Fceph-osd\u002F",[825],[568,1222,1224],{"id":1223},"mds-metadata-server-daemon","MDS - Metadata Server Daemon",[524,1226,1227],{},"The MDS is the metadata server for the CephFilesystem (CephFS).",[524,1229,1230],{},"It talks with the OSDs and coordinates the filesystem access. Clients still need to access the OSDs, but the MDS is the \"gateway\" to know where to go so to say.",[573,1232,1233],{},[576,1234,1236],{"className":578,"code":1235,"language":573,"meta":580,"style":580},"---\nconfig:\n  layout: elk\n---\ngraph LR\n    Client-A --> MDS-1\n    Client-B --> MDS-1\n    Client-C ---> MDS-2\n\n    MDS-1 -.- MDS-2\n    MDS-1 --> OSDs\n    MDS-2 --> OSDs\n\n    Client-A ---> OSDs\n    Client-B ---> OSDs\n    Client-C ---> OSDs\n",[582,1237,1238,1242,1246,1250,1254,1260,1270,1279,1290,1294,1303,1312,1321,1325,1333,1341],{"__ignoreMap":580},[585,1239,1240],{"class":587,"line":588},[585,1241,942],{"class":617},[585,1243,1244],{"class":587,"line":599},[585,1245,947],{"class":617},[585,1247,1248],{"class":587,"line":608},[585,1249,952],{"class":617},[585,1251,1252],{"class":587,"line":631},[585,1253,942],{"class":617},[585,1255,1256,1258],{"class":587,"line":644},[585,1257,592],{"class":591},[585,1259,596],{"class":595},[585,1261,1262,1265,1267],{"class":587,"line":657},[585,1263,1264],{"class":617},"    Client-A ",[585,1266,970],{"class":591},[585,1268,1269],{"class":617}," MDS-1\n",[585,1271,1272,1275,1277],{"class":587,"line":663},[585,1273,1274],{"class":617},"    Client-B ",[585,1276,970],{"class":591},[585,1278,1269],{"class":617},[585,1280,1281,1284,1287],{"class":587,"line":670},[585,1282,1283],{"class":617},"    Client-C ",[585,1285,1286],{"class":591},"--->",[585,1288,1289],{"class":617}," MDS-2\n",[585,1291,1292],{"class":587,"line":687},[585,1293,667],{"emptyLinePlaceholder":666},[585,1295,1296,1299,1301],{"class":587,"line":700},[585,1297,1298],{"class":617},"    MDS-1 ",[585,1300,801],{"class":591},[585,1302,1289],{"class":617},[585,1304,1305,1307,1309],{"class":587,"line":713},[585,1306,1298],{"class":617},[585,1308,970],{"class":591},[585,1310,1311],{"class":617}," OSDs\n",[585,1313,1314,1317,1319],{"class":587,"line":718},[585,1315,1316],{"class":617},"    MDS-2 ",[585,1318,970],{"class":591},[585,1320,1311],{"class":617},[585,1322,1323],{"class":587,"line":1102},[585,1324,667],{"emptyLinePlaceholder":666},[585,1326,1327,1329,1331],{"class":587,"line":1111},[585,1328,1264],{"class":617},[585,1330,1286],{"class":591},[585,1332,1311],{"class":617},[585,1334,1335,1337,1339],{"class":587,"line":1120},[585,1336,1274],{"class":617},[585,1338,1286],{"class":591},[585,1340,1311],{"class":617},[585,1342,1343,1345,1347],{"class":587,"line":1125},[585,1344,1283],{"class":617},[585,1346,1286],{"class":591},[585,1348,1311],{"class":617},[524,1350,1351,819,1353],{},[734,1352,818],{},[821,1354,1355],{"href":1355,"rel":1356},"https:\u002F\u002Fdocs.ceph.com\u002Fen\u002Flatest\u002Fman\u002F8\u002Fceph-mds\u002F",[825],[568,1358,1360],{"id":1359},"rgw-rados-rest-gateway","RGW - RADOS REST Gateway",[524,1362,1363],{},"RGW can offer S3 and\u002F or SWIFT compatible storage, allowing to use it as a \"replacement\" for AWS S3 object storage in some cases.\nAn advantage to, e.g., the block storage (RBD) and CephFS is that the client itself does not need direct access to the MONs, OSDs, etc., though it depends on the use case and the performance required per client\u002F application.",[573,1365,1366],{},[576,1367,1369],{"className":578,"code":1368,"language":573,"meta":580,"style":580},"---\nconfig:\n  layout: elk\n---\ngraph LR\n    Client-A --> RGW-1\n    Client-B --> RGW-1\n    Client-C --> RGW-2\n    RGW-1 --> OSDs\n    RGW-2 --> OSDs\n",[582,1370,1371,1375,1379,1383,1387,1393,1402,1410,1419,1428],{"__ignoreMap":580},[585,1372,1373],{"class":587,"line":588},[585,1374,942],{"class":617},[585,1376,1377],{"class":587,"line":599},[585,1378,947],{"class":617},[585,1380,1381],{"class":587,"line":608},[585,1382,952],{"class":617},[585,1384,1385],{"class":587,"line":631},[585,1386,942],{"class":617},[585,1388,1389,1391],{"class":587,"line":644},[585,1390,592],{"class":591},[585,1392,596],{"class":595},[585,1394,1395,1397,1399],{"class":587,"line":657},[585,1396,1264],{"class":617},[585,1398,970],{"class":591},[585,1400,1401],{"class":617}," RGW-1\n",[585,1403,1404,1406,1408],{"class":587,"line":663},[585,1405,1274],{"class":617},[585,1407,970],{"class":591},[585,1409,1401],{"class":617},[585,1411,1412,1414,1416],{"class":587,"line":670},[585,1413,1283],{"class":617},[585,1415,970],{"class":591},[585,1417,1418],{"class":617}," RGW-2\n",[585,1420,1421,1424,1426],{"class":587,"line":687},[585,1422,1423],{"class":617},"    RGW-1 ",[585,1425,970],{"class":591},[585,1427,1311],{"class":617},[585,1429,1430,1433,1435],{"class":587,"line":700},[585,1431,1432],{"class":617},"    RGW-2 ",[585,1434,970],{"class":591},[585,1436,1311],{"class":617},[524,1438,1439],{},"Common scenario is that you have a load balancer in front of your RGWs, in itself the structure stays the same:",[573,1441,1442],{},[576,1443,1445],{"className":578,"code":1444,"language":573,"meta":580,"style":580},"---\nconfig:\n  layout: elk\n---\ngraph LR\n    Client-A --> Loadbalancer\n    Client-B --> Loadbalancer\n    Client-C --> Loadbalancer\n    Loadbalancer --> RGW-1\n    Loadbalancer --> RGW-2\n    RGW-1 --> OSDs\n    RGW-2 --> OSDs\n",[582,1446,1447,1451,1455,1459,1463,1469,1478,1486,1494,1503,1511,1519],{"__ignoreMap":580},[585,1448,1449],{"class":587,"line":588},[585,1450,942],{"class":617},[585,1452,1453],{"class":587,"line":599},[585,1454,947],{"class":617},[585,1456,1457],{"class":587,"line":608},[585,1458,952],{"class":617},[585,1460,1461],{"class":587,"line":631},[585,1462,942],{"class":617},[585,1464,1465,1467],{"class":587,"line":644},[585,1466,592],{"class":591},[585,1468,596],{"class":595},[585,1470,1471,1473,1475],{"class":587,"line":657},[585,1472,1264],{"class":617},[585,1474,970],{"class":591},[585,1476,1477],{"class":617}," Loadbalancer\n",[585,1479,1