[{"data":1,"prerenderedAt":1630,"buildId":1631},["ShallowReactive",2],{"\u002Fdocs\u002Fstorage\u002Fceph\u002Farchitecture":3,"\u002Fdocs\u002Fstorage\u002Fceph\u002Farchitecture-surround":1115,"navigation":1124},{"id":4,"title":5,"body":6,"description":12,"extension":1108,"meta":1109,"navigation":152,"path":1111,"seo":1112,"stem":1113,"__hash__":1114},"docs\u002F1.docs\u002Fstorage\u002Fceph\u002Farchitecture.md","Architecture",{"type":7,"value":8,"toc":1091},"minimark",[9,13,18,53,58,208,212,216,224,227,300,312,317,320,390,399,403,414,417,487,490,498,502,505,682,699,707,711,714,717,835,843,847,850,923,926,1013,1021,1024,1038,1040,1044,1053,1057,1064,1068,1071,1077,1081,1087],[10,11,12],"p",{},"Ceph offers block storage (RBD), network filesystem (CephFS), object storage (RGW, S3, SWIFT) and key value storage (librados).",[14,15,17],"h2",{"id":16},"glossary","Glossary",[19,20,21,39],"ul",{},[22,23,24,25],"li",{},"Daemons\n",[19,26,27,30,33,36],{},[22,28,29],{},"MON: Monitor Daemon",[22,31,32],{},"MGR: Manager Daemon",[22,34,35],{},"OSD: Object Storage Daemon",[22,37,38],{},"RGW: Rados Gateway",[22,40,41,42],{},"\"Things\"\n",[19,43,44,47,50],{},[22,45,46],{},"Pool: Group of PGs, separation .",[22,48,49],{},"PG: Placement Group, group of objects in a pool.",[22,51,52],{},"Object: A single object \"somewhere in the cluster\". Part of a PG.",[54,55,57],"h3",{"id":56},"pool-pg-object","Pool -> PG -> Object",[59,60,61],"mermaid",{},[62,63,67],"pre",{"className":64,"code":65,"language":59,"meta":66,"style":66},"language-mermaid shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","graph LR\nsubgraph Pool\n    subgraph PG-2[PG 2]\n        Object-1[Object 1]\n        Object-2[Object 2]\n    end\n\n    subgraph PG-1[PG 1]\n        Object-3[Object 3]\n        Object-4[Object 4]\n    end\nend\n","",[68,69,70,83,92,115,128,141,147,154,171,184,197,202],"code",{"__ignoreMap":66},[71,72,75,79],"span",{"class":73,"line":74},"line",1,[71,76,78],{"class":77},"s7zQu","graph",[71,80,82],{"class":81},"s2Zo4"," LR\n",[71,84,86,89],{"class":73,"line":85},2,[71,87,88],{"class":77},"subgraph",[71,90,91],{"class":81}," Pool\n",[71,93,95,98,101,105,108,112],{"class":73,"line":94},3,[71,96,97],{"class":77},"    subgraph",[71,99,100],{"class":81}," PG",[71,102,104],{"class":103},"sTEyZ","-2",[71,106,107],{"class":77},"[",[71,109,111],{"class":110},"sfazB","PG 2",[71,113,114],{"class":77},"]\n",[71,116,118,121,123,126],{"class":73,"line":117},4,[71,119,120],{"class":103},"        Object-1",[71,122,107],{"class":77},[71,124,125],{"class":110},"Object 1",[71,127,114],{"class":77},[71,129,131,134,136,139],{"class":73,"line":130},5,[71,132,133],{"class":103},"        Object-2",[71,135,107],{"class":77},[71,137,138],{"class":110},"Object 2",[71,140,114],{"class":77},[71,142,144],{"class":73,"line":143},6,[71,145,146],{"class":77},"    end\n",[71,148,150],{"class":73,"line":149},7,[71,151,153],{"emptyLinePlaceholder":152},true,"\n",[71,155,157,159,161,164,166,169],{"class":73,"line":156},8,[71,158,97],{"class":77},[71,160,100],{"class":81},[71,162,163],{"class":103},"-1",[71,165,107],{"class":77},[71,167,168],{"class":110},"PG 1",[71,170,114],{"class":77},[71,172,174,177,179,182],{"class":73,"line":173},9,[71,175,176],{"class":103},"        Object-3",[71,178,107],{"class":77},[71,180,181],{"class":110},"Object 3",[71,183,114],{"class":77},[71,185,187,190,192,195],{"class":73,"line":186},10,[71,188,189],{"class":103},"        Object-4",[71,191,107],{"class":77},[71,193,194],{"class":110},"Object 4",[71,196,114],{"class":77},[71,198,200],{"class":73,"line":199},11,[71,201,146],{"class":77},[71,203,205],{"class":73,"line":204},12,[71,206,207],{"class":77},"end\n",[14,209,211],{"id":210},"ceph-cluster-components","Ceph Cluster Components",[54,213,215],{"id":214},"mon-monitor-daemon","MON - Monitor Daemon",[10,217,218,219,223],{},"The MONs are keeping a ",[220,221,222],"strong",{},"map"," of the current MONs, OSDs, PGs, Pools and so on.",[10,225,226],{},"MONs require a quorum to function, meaning that you should always run at least 3 mons for production 5 can be a good idea as well.",[59,228,229],{},[62,230,232],{"className":64,"code":231,"language":59,"meta":66,"style":66},"graph LR\n    MON-A[\"MON A\"]\n    MON-B[\"MON B\"]\n    MON-C[\"MON C\"]\n\n    MON-A -.- MON-B\n    MON-A -.- MON-C\n",[68,233,234,240,252,264,276,280,291],{"__ignoreMap":66},[71,235,236,238],{"class":73,"line":74},[71,237,78],{"class":77},[71,239,82],{"class":81},[71,241,242,245,247,250],{"class":73,"line":85},[71,243,244],{"class":103},"    MON-A",[71,246,107],{"class":77},[71,248,249],{"class":110},"\"MON A\"",[71,251,114],{"class":77},[71,253,254,257,259,262],{"class":73,"line":94},[71,255,256],{"class":103},"    MON-B",[71,258,107],{"class":77},[71,260,261],{"class":110},"\"MON B\"",[71,263,114],{"class":77},[71,265,266,269,271,274],{"class":73,"line":117},[71,267,268],{"class":103},"    MON-C",[71,270,107],{"class":77},[71,272,273],{"class":110},"\"MON C\"",[71,275,114],{"class":77},[71,277,278],{"class":73,"line":130},[71,279,153],{"emptyLinePlaceholder":152},[71,281,282,285,288],{"class":73,"line":143},[71,283,284],{"class":103},"    MON-A ",[71,286,287],{"class":77},"-.-",[71,289,290],{"class":103}," MON-B\n",[71,292,293,295,297],{"class":73,"line":149},[71,294,284],{"class":103},[71,296,287],{"class":77},[71,298,299],{"class":103}," MON-C\n",[10,301,302,305,306],{},[220,303,304],{},"Man Page",": ",[307,308,309],"a",{"href":309,"rel":310},"https:\u002F\u002Fdocs.ceph.com\u002Fen\u002Flatest\u002Fman\u002F8\u002Fceph-mon\u002F",[311],"nofollow",[313,314,316],"h4",{"id":315},"quorum","Quorum",[10,318,319],{},"Simply put, if you run with 3 MONs you can lose 1 MON before the cluster will come to a halt as the quorum would be lost.",[321,322,323,336],"table",{},[324,325,326],"thead",{},[327,328,329,333],"tr",{},[330,331,332],"th",{},"MONs",[330,334,335],{},"How many can be lost?",[337,338,339,348,355,362,369,376,383],"tbody",{},[327,340,341,345],{},[342,343,344],"td",{},"1",[342,346,347],{},"0",[327,349,350,353],{},[342,351,352],{},"2",[342,354,347],{},[327,356,357,360],{},[342,358,359],{},"3",[342,361,344],{},[327,363,364,367],{},[342,365,366],{},"4",[342,368,344],{},[327,370,371,374],{},[342,372,373],{},"5",[342,375,352],{},[327,377,378,381],{},[342,379,380],{},"6",[342,382,352],{},[327,384,385,388],{},[342,386,387],{},"7",[342,389,359],{},[10,391,392,393,398],{},"For more information regarding quorum, checkout the following link from the ETCD documentation: ",[307,394,397],{"href":395,"rel":396},"https:\u002F\u002Fetcd.io\u002Fdocs\u002Fv3.3\u002Ffaq\u002F#why-an-odd-number-of-cluster-members",[311],"ETCD v3.3. - FAQ Why an odd number of cluster members?",".\nETCD is a good example of an infrastructure critical application (for Kubernetes) which requires a Quorum for (most; depending on your settings) operations.",[54,400,402],{"id":401},"mgr-manager-daemon","MGR - Manager Daemon",[10,404,405,406,409,410,413],{},"The MGR daemon(s) \"provide additional monitoring and interfaces to external monitoring and management systems\". You need to have at least one running as otherwise certain status information in, e.g., ",[68,407,408],{},"ceph status"," (",[68,411,412],{},"ceph -s","), will not be shown.\nIt is recommended to run at least 1.",[10,415,416],{},"The MGR daemon(s) talk with the MON, OSD MDS, and even RGW.",[59,418,419],{},[62,420,422],{"className":64,"code":421,"language":59,"meta":66,"style":66},"---\nconfig:\n  layout: elk\n---\ngraph LR\n    MGR --> MON\n    MGR --> OSD\n    MGR --> MDS\n    MGR --> RGW\n",[68,423,424,429,434,439,443,449,460,469,478],{"__ignoreMap":66},[71,425,426],{"class":73,"line":74},[71,427,428],{"class":103},"---\n",[71,430,431],{"class":73,"line":85},[71,432,433],{"class":103},"config:\n",[71,435,436],{"class":73,"line":94},[71,437,438],{"class":103},"  layout: elk\n",[71,440,441],{"class":73,"line":117},[71,442,428],{"class":103},[71,444,445,447],{"class":73,"line":130},[71,446,78],{"class":77},[71,448,82],{"class":81},[71,450,451,454,457],{"class":73,"line":143},[71,452,453],{"class":103},"    MGR ",[71,455,456],{"class":77},"-->",[71,458,459],{"class":103}," MON\n",[71,461,462,464,466],{"class":73,"line":149},[71,463,453],{"class":103},[71,465,456],{"class":77},[71,467,468],{"class":103}," OSD\n",[71,470,471,473,475],{"class":73,"line":156},[71,472,453],{"class":103},[71,474,456],{"class":77},[71,476,477],{"class":103}," MDS\n",[71,479,480,482,484],{"class":73,"line":173},[71,481,453],{"class":103},[71,483,456],{"class":77},[71,485,486],{"class":103}," RGW\n",[10,488,489],{},"The MGR daemon(s) have many modules to for example provide metrics for Prometheus, Zabbix and others. In addition to that a Ceph dashboard can be activated which contains some basic information and even an integration with Prometheus and Grafana.",[10,491,492,305,494],{},[220,493,304],{},[307,495,496],{"href":496,"rel":497},"https:\u002F\u002Fdocs.ceph.com\u002Fen\u002Flatest\u002Fmgr\u002Findex.html",[311],[54,499,501],{"id":500},"osd-object-storage-daemon","OSD - Object Storage Daemon",[10,503,504],{},"All OSDs normally talk with each other for hearbeat ❤️ checking and data replication (actual data and also for data \"scrubbing\" operations).",[59,506,507],{},[62,508,510],{"className":64,"code":509,"language":59,"meta":66,"style":66},"---\nconfig:\n  layout: elk\n---\ngraph LR\n    OSD-0\n    OSD-0 -.- OSD-1\n    OSD-0 -.- OSD-2\n    OSD-0 -.- OSD-n\n\n    OSD-1\n    OSD-1 -.- OSD-0\n    OSD-1 -.- OSD-2\n    OSD-1 -.- OSD-n\n\n    OSD-2\n    OSD-2 -.- OSD-0\n    OSD-2 -.- OSD-1\n    OSD-2 -.- OSD-n\n\n    OSD-n\n    OSD-n -.- OSD-0\n    OSD-n -.- OSD-1\n    OSD-n -.- OSD-2\n",[68,511,512,516,520,524,528,534,539,549,558,567,571,576,586,595,604,609,615,625,634,643,648,654,664,673],{"__ignoreMap":66},[71,513,514],{"class":73,"line":74},[71,515,428],{"class":103},[71,517,518],{"class":73,"line":85},[71,519,433],{"class":103},[71,521,522],{"class":73,"line":94},[71,523,438],{"class":103},[71,525,526],{"class":73,"line":117},[71,527,428],{"class":103},[71,529,530,532],{"class":73,"line":130},[71,531,78],{"class":77},[71,533,82],{"class":81},[71,535,536],{"class":73,"line":143},[71,537,538],{"class":103},"    OSD-0\n",[71,540,541,544,546],{"class":73,"line":149},[71,542,543],{"class":103},"    OSD-0 ",[71,545,287],{"class":77},[71,547,548],{"class":103}," OSD-1\n",[71,550,551,553,555],{"class":73,"line":156},[71,552,543],{"class":103},[71,554,287],{"class":77},[71,556,557],{"class":103}," OSD-2\n",[71,559,560,562,564],{"class":73,"line":173},[71,561,543],{"class":103},[71,563,287],{"class":77},[71,565,566],{"class":103}," OSD-n\n",[71,568,569],{"class":73,"line":186},[71,570,153],{"emptyLinePlaceholder":152},[71,572,573],{"class":73,"line":199},[71,574,575],{"class":103},"    OSD-1\n",[71,577,578,581,583],{"class":73,"line":204},[71,579,580],{"class":103},"    OSD-1 ",[71,582,287],{"class":77},[71,584,585],{"class":103}," OSD-0\n",[71,587,589,591,593],{"class":73,"line":588},13,[71,590,580],{"class":103},[71,592,287],{"class":77},[71,594,557],{"class":103},[71,596,598,600,602],{"class":73,"line":597},14,[71,599,580],{"class":103},[71,601,287],{"class":77},[71,603,566],{"class":103},[71,605,607],{"class":73,"line":606},15,[71,608,153],{"emptyLinePlaceholder":152},[71,610,612],{"class":73,"line":611},16,[71,613,614],{"class":103},"    OSD-2\n",[71,616,618,621,623],{"class":73,"line":617},17,[71,619,620],{"class":103},"    OSD-2 ",[71,622,287],{"class":77},[71,624,585],{"class":103},[71,626,628,630,632],{"class":73,"line":627},18,[71,629,620],{"class":103},[71,631,287],{"class":77},[71,633,548],{"class":103},[71,635,637,639,641],{"class":73,"line":636},19,[71,638,620],{"class":103},[71,640,287],{"class":77},[71,642,566],{"class":103},[71,644,646],{"class":73,"line":645},20,[71,647,153],{"emptyLinePlaceholder":152},[71,649,651],{"class":73,"line":650},21,[71,652,653],{"class":103},"    OSD-n\n",[71,655,657,660,662],{"class":73,"line":656},22,[71,658,659],{"class":103},"    OSD-n ",[71,661,287],{"class":77},[71,663,585],{"class":103},[71,665,667,669,671],{"class":73,"line":666},23,[71,668,659],{"class":103},[71,670,287],{"class":77},[71,672,548],{"class":103},[71,674,676,678,680],{"class":73,"line":675},24,[71,677,659],{"class":103},[71,679,287],{"class":77},[71,681,557],{"class":103},[19,683,684,687,690],{},[22,685,686],{},"If a client writes data, the data is replicated by the OSD and not the client.",[22,688,689],{},"If a client reads data, the data can be read from multiple OSDs at the same time (as long as they have a replica of the data).",[22,691,692,305,695],{},[220,693,694],{},"Side note",[696,697,698],"em",{},"That is the reason why read speeds are so fast and writes can be so slow. One slow OSD can \"ruin your day\" because of that.",[10,700,701,305,703],{},[220,702,304],{},[307,704,705],{"href":705,"rel":706},"https:\u002F\u002Fdocs.ceph.com\u002Fen\u002Flatest\u002Fman\u002F8\u002Fceph-osd\u002F",[311],[54,708,710],{"id":709},"mds-metadata-server-daemon","MDS - Metadata Server Daemon",[10,712,713],{},"The MDS is the metadata server for the CephFilesystem (CephFS).",[10,715,716],{},"It talks with the OSDs and coordinates the filesystem access. Clients still need to access the OSDs, but the MDS is the \"gateway\" to know where to go so to say.",[59,718,719],{},[62,720,722],{"className":64,"code":721,"language":59,"meta":66,"style":66},"---\nconfig:\n  layout: elk\n---\ngraph LR\n    Client-A --> MDS-1\n    Client-B --> MDS-1\n    Client-C ---> MDS-2\n\n    MDS-1 -.- MDS-2\n    MDS-1 --> OSDs\n    MDS-2 --> OSDs\n\n    Client-A ---> OSDs\n    Client-B ---> OSDs\n    Client-C ---> OSDs\n",[68,723,724,728,732,736,740,746,756,765,776,780,789,798,807,811,819,827],{"__ignoreMap":66},[71,725,726],{"class":73,"line":74},[71,727,428],{"class":103},[71,729,730],{"class":73,"line":85},[71,731,433],{"class":103},[71,733,734],{"class":73,"line":94},[71,735,438],{"class":103},[71,737,738],{"class":73,"line":117},[71,739,428],{"class":103},[71,741,742,744],{"class":73,"line":130},[71,743,78],{"class":77},[71,745,82],{"class":81},[71,747,748,751,753],{"class":73,"line":143},[71,749,750],{"class":103},"    Client-A ",[71,752,456],{"class":77},[71,754,755],{"class":103}," MDS-1\n",[71,757,758,761,763],{"class":73,"line":149},[71,759,760],{"class":103},"    Client-B ",[71,762,456],{"class":77},[71,764,755],{"class":103},[71,766,767,770,773],{"class":73,"line":156},[71,768,769],{"class":103},"    Client-C ",[71,771,772],{"class":77},"--->",[71,774,775],{"class":103}," MDS-2\n",[71,777,778],{"class":73,"line":173},[71,779,153],{"emptyLinePlaceholder":152},[71,781,782,785,787],{"class":73,"line":186},[71,783,784],{"class":103},"    MDS-1 ",[71,786,287],{"class":77},[71,788,775],{"class":103},[71,790,791,793,795],{"class":73,"line":199},[71,792,784],{"class":103},[71,794,456],{"class":77},[71,796,797],{"class":103}," OSDs\n",[71,799,800,803,805],{"class":73,"line":204},[71,801,802],{"class":103},"    MDS-2 ",[71,804,456],{"class":77},[71,806,797],{"class":103},[71,808,809],{"class":73,"line":588},[71,810,153],{"emptyLinePlaceholder":152},[71,812,813,815,817],{"class":73,"line":597},[71,814,750],{"class":103},[71,816,772],{"class":77},[71,818,797],{"class":103},[71,820,821,823,825],{"class":73,"line":606},[71,822,760],{"class":103},[71,824,772],{"class":77},[71,826,797],{"class":103},[71,828,829,831,833],{"class":73,"line":611},[71,830,769],{"class":103},[71,832,772],{"class":77},[71,834,797],{"class":103},[10,836,837,305,839],{},[220,838,304],{},[307,840,841],{"href":841,"rel":842},"https:\u002F\u002Fdocs.ceph.com\u002Fen\u002Flatest\u002Fman\u002F8\u002Fceph-mds\u002F",[311],[54,844,846],{"id":845},"rgw-rados-rest-gateway","RGW - RADOS REST Gateway",[10,848,849],{},"RGW can offer S3 and\u002F or SWIFT compatible storage, allowing to use it as a \"replacement\" for AWS S3 object storage in some cases.\nAn advantage to, e.g., the block storage (RBD) and CephFS is that the client itself does not need direct access to the MONs, OSDs, etc., though it depends on the use case and the performance required per client\u002F application.",[59,851,852],{},[62,853,855],{"className":64,"code":854,"language":59,"meta":66,"style":66},"---\nconfig:\n  layout: elk\n---\ngraph LR\n    Client-A --> RGW-1\n    Client-B --> RGW-1\n    Client-C --> RGW-2\n    RGW-1 --> OSDs\n    RGW-2 --> OSDs\n",[68,856,857,861,865,869,873,879,888,896,905,914],{"__ignoreMap":66},[71,858,859],{"class":73,"line":74},[71,860,428],{"class":103},[71,862,863],{"class":73,"line":85},[71,864,433],{"class":103},[71,866,867],{"class":73,"line":94},[71,868,438],{"class":103},[71,870,871],{"class":73,"line":117},[71,872,428],{"class":103},[71,874,875,877],{"class":73,"line":130},[71,876,78],{"class":77},[71,878,82],{"class":81},[71,880,881,883,885],{"class":73,"line":143},[71,882,750],{"class":103},[71,884,456],{"class":77},[71,886,887],{"class":103}," RGW-1\n",[71,889,890,892,894],{"class":73,"line":149},[71,891,760],{"class":103},[71,893,456],{"class":77},[71,895,887],{"class":103},[71,897,898,900,902],{"class":73,"line":156},[71,899,769],{"class":103},[71,901,456],{"class":77},[71,903,904],{"class":103}," RGW-2\n",[71,906,907,910,912],{"class":73,"line":173},[71,908,909],{"class":103},"    RGW-1 ",[71,911,456],{"class":77},[71,913,797],{"class":103},[71,915,916,919,921],{"class":73,"line":186},[71,917,918],{"class":103},"    RGW-2 ",[71,920,456],{"class":77},[71,922,797],{"class":103},[10,924,925],{},"Common scenario is that you have a load balancer in front of your RGWs, in itself the structure stays the same:",[59,927,928],{},[62,929,931],{"className":64,"code":930,"language":59,"meta":66,"style":66},"---\nconfig:\n  layout: elk\n---\ngraph LR\n    Client-A --> Loadbalancer\n    Client-B --> Loadbalancer\n    Client-C --> Loadbalancer\n    Loadbalancer --> RGW-1\n    Loadbalancer --> RGW-2\n    RGW-1 --> OSDs\n    RGW-2 --> OSDs\n",[68,932,93