e-edit-outline","\u002Fdocs\u002Fweb\u002Ftiptap","1.docs\u002Fweb\u002Ftiptap",[504],{"title":505,"path":506,"stem":507},"Snippets","\u002Fdocs\u002Fweb\u002Ftiptap\u002Fsnippets","1.docs\u002Fweb\u002Ftiptap\u002Fsnippets",{"id":509,"title":433,"body":510,"description":516,"extension":1612,"meta":1613,"navigation":656,"path":434,"seo":1615,"stem":435,"__hash__":1616},"docs\u002F1.docs\u002Fstorage\u002Fceph\u002Farchitecture.md",{"type":511,"value":512,"toc":1595},"minimark",[513,517,522,557,562,712,716,720,728,731,804,816,821,824,894,903,907,918,921,991,994,1002,1006,1009,1186,1203,1211,1215,1218,1221,1339,1347,1351,1354,1427,1430,1517,1525,1528,1542,1544,1548,1557,1561,1568,1572,1575,1581,1585,1591],[514,515,516],"p",{},"Ceph offers block storage (RBD), network filesystem (CephFS), object storage (RGW, S3, SWIFT) and key value storage (librados).",[518,519,521],"h2",{"id":520},"glossary","Glossary",[523,524,525,543],"ul",{},[526,527,528,529],"li",{},"Daemons\n",[523,530,531,534,537,540],{},[526,532,533],{},"MON: Monitor Daemon",[526,535,536],{},"MGR: Manager Daemon",[526,538,539],{},"OSD: Object Storage Daemon",[526,541,542],{},"RGW: Rados Gateway",[526,544,545,546],{},"\"Things\"\n",[523,547,548,551,554],{},[526,549,550],{},"Pool: Group of PGs, separation .",[526,552,553],{},"PG: Placement Group, group of objects in a pool.",[526,555,556],{},"Object: A single object \"somewhere in the cluster\". Part of a PG.",[558,559,561],"h3",{"id":560},"pool-pg-object","Pool -> PG -> Object",[563,564,565],"mermaid",{},[566,567,571],"pre",{"className":568,"code":569,"language":563,"meta":570,"style":570},"language-mermaid shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","graph LR\nsubgraph Pool\n    subgraph PG-2[PG 2]\n        Object-1[Object 1]\n        Object-2[Object 2]\n    end\n\n    subgraph PG-1[PG 1]\n        Object-3[Object 3]\n        Object-4[Object 4]\n    end\nend\n","",[572,573,574,587,596,619,632,645,651,658,675,688,701,706],"code",{"__ignoreMap":570},[575,576,579,583],"span",{"class":577,"line":578},"line",1,[575,580,582],{"class":581},"s7zQu","graph",[575,584,586],{"class":585},"s2Zo4"," LR\n",[575,588,590,593],{"class":577,"line":589},2,[575,591,592],{"class":581},"subgraph",[575,594,595],{"class":585}," Pool\n",[575,597,599,602,605,609,612,616],{"class":577,"line":598},3,[575,600,601],{"class":581},"    subgraph",[575,603,604],{"class":585}," PG",[575,606,608],{"class":607},"sTEyZ","-2",[575,610,611],{"class":581},"[",[575,613,615],{"class":614},"sfazB","PG 2",[575,617,618],{"class":581},"]\n",[575,620,622,625,627,630],{"class":577,"line":621},4,[575,623,624],{"class":607},"        Object-1",[575,626,611],{"class":581},[575,628,629],{"class":614},"Object 1",[575,631,618],{"class":581},[575,633,635,638,640,643],{"class":577,"line":634},5,[575,636,637],{"class":607},"        Object-2",[575,639,611],{"class":581},[575,641,642],{"class":614},"Object 2",[575,644,618],{"class":581},[575,646,648],{"class":577,"line":647},6,[575,649,650],{"class":581},"    end\n",[575,652,654],{"class":577,"line":653},7,[575,655,657],{"emptyLinePlaceholder":656},true,"\n",[575,659,661,663,665,668,670,673],{"class":577,"line":660},8,[575,662,601],{"class":581},[575,664,604],{"class":585},[575,666,667],{"class":607},"-1",[575,669,611],{"class":581},[575,671,672],{"class":614},"PG 1",[575,674,618],{"class":581},[575,676,678,681,683,686],{"class":577,"line":677},9,[575,679,680],{"class":607},"        Object-3",[575,682,611],{"class":581},[575,684,685],{"class":614},"Object 3",[575,687,618],{"class":581},[575,689,691,694,696,699],{"class":577,"line":690},10,[575,692,693],{"class":607},"        Object-4",[575,695,611],{"class":581},[575,697,698],{"class":614},"Object 4",[575,700,618],{"class":581},[575,702,704],{"class":577,"line":703},11,[575,705,650],{"class":581},[575,707,709],{"class":577,"line":708},12,[575,710,711],{"class":581},"end\n",[518,713,715],{"id":714},"ceph-cluster-components","Ceph Cluster Components",[558,717,719],{"id":718},"mon-monitor-daemon","MON - Monitor Daemon",[514,721,722,723,727],{},"The MONs are keeping a ",[724,725,726],"strong",{},"map"," of the current MONs, OSDs, PGs, Pools and so on.",[514,729,730],{},"MONs require a quorum to function, meaning that you should always run at least 3 mons for production 5 can be a good idea as well.",[563,732,733],{},[566,734,736],{"className":568,"code":735,"language":563,"meta":570,"style":570},"graph LR\n    MON-A[\"MON A\"]\n    MON-B[\"MON B\"]\n    MON-C[\"MON C\"]\n\n    MON-A -.- MON-B\n    MON-A -.- MON-C\n",[572,737,738,744,756,768,780,784,795],{"__ignoreMap":570},[575,739,740,742],{"class":577,"line":578},[575,741,582],{"class":581},[575,743,586],{"class":585},[575,745,746,749,751,754],{"class":577,"line":589},[575,747,748],{"class":607},"    MON-A",[575,750,611],{"class":581},[575,752,753],{"class":614},"\"MON A\"",[575,755,618],{"class":581},[575,757,758,761,763,766],{"class":577,"line":598},[575,759,760],{"class":607},"    MON-B",[575,762,611],{"class":581},[575,764,765],{"class":614},"\"MON B\"",[575,767,618],{"class":581},[575,769,770,773,775,778],{"class":577,"line":621},[575,771,772],{"class":607},"    MON-C",[575,774,611],{"class":581},[575,776,777],{"class":614},"\"MON C\"",[575,779,618],{"class":581},[575,781,782],{"class":577,"line":634},[575,783,657],{"emptyLinePlaceholder":656},[575,785,786,789,792],{"class":577,"line":647},[575,787,788],{"class":607},"    MON-A ",[575,790,791],{"class":581},"-.-",[575,793,794],{"class":607}," MON-B\n",[575,796,797,799,801],{"class":577,"line":653},[575,798,788],{"class":607},[575,800,791],{"class":581},[575,802,803],{"class":607}," MON-C\n",[514,805,806,809,810],{},[724,807,808],{},"Man Page",": ",[811,812,813],"a",{"href":813,"rel":814},"https:\u002F\u002Fdocs.ceph.com\u002Fen\u002Flatest\u002Fman\u002F8\u002Fceph-mon\u002F",[815],"nofollow",[817,818,820],"h4",{"id":819},"quorum","Quorum",[514,822,823],{},"Simply put, if you run with 3 MONs you can lose 1 MON before the cluster will come to a halt as the quorum would be lost.",[825,826,827,840],"table",{},[828,829,830],"thead",{},[831,832,833,837],"tr",{},[834,835,836],"th",{},"MONs",[834,838,839],{},"How many can be lost?",[841,842,843,852,859,866,873,880,887],"tbody",{},[831,844,845,849],{},[846,847,848],"td",{},"1",[846,850,851],{},"0",[831,853,854,857],{},[846,855,856],{},"2",[846,858,851],{},[831,860,861,864],{},[846,862,863],{},"3",[846,865,848],{},[831,867,868,871],{},[846,869,870],{},"4",[846,872,848],{},[831,874,875,878],{},[846,876,877],{},"5",[846,879,856],{},[831,881,882,885],{},[846,883,884],{},"6",[846,886,856],{},[831,888,889,892],{},[846,890,891],{},"7",[846,893,863],{},[514,895,896,897,902],{},"For more information regarding quorum, checkout the following link from the ETCD documentation: ",[811,898,901],{"href":899,"rel":900},"https:\u002F\u002Fetcd.io\u002Fdocs\u002Fv3.3\u002Ffaq\u002F#why-an-odd-number-of-cluster-members",[815],"ETCD v3.3. - FAQ Why an odd number of cluster members?",".\nETCD is a good example of an infrastructure critical application (for Kubernetes) which requires a Quorum for (most; depending on your settings) operations.",[558,904,906],{"id":905},"mgr-manager-daemon","MGR - Manager Daemon",[514,908,909,910,913,914,917],{},"The MGR daemon(s) \"provide additional monitoring and interfaces to external monitoring and management systems\". You need to have at least one running as otherwise certain status information in, e.g., ",[572,911,912],{},"ceph status"," (",[572,915,916],{},"ceph -s","), will not be shown.\nIt is recommended to run at least 1.",[514,919,920],{},"The MGR daemon(s) talk with the MON, OSD MDS, and even RGW.",[563,922,923],{},[566,924,926],{"className":568,"code":925,"language":563,"meta":570,"style":570},"---\nconfig:\n  layout: elk\n---\ngraph LR\n    MGR --> MON\n    MGR --> OSD\n    MGR --> MDS\n    MGR --> RGW\n",[572,927,928,933,938,943,947,953,964,973,982],{"__ignoreMap":570},[575,929,930],{"class":577,"line":578},[575,931,932],{"class":607},"---\n",[575,934,935],{"class":577,"line":589},[575,936,937],{"class":607},"config:\n",[575,939,940],{"class":577,"line":598},[575,941,942],{"class":607},"  layout: elk\n",[575,944,945],{"class":577,"line":621},[575,946,932],{"class":607},[575,948,949,951],{"class":577,"line":634},[575,950,582],{"class":581},[575,952,586],{"class":585},[575,954,955,958,961],{"class":577,"line":647},[575,956,957],{"class":607},"    MGR ",[575,959,960],{"class":581},"-->",[575,962,963],{"class":607}," MON\n",[575,965,966,968,970],{"class":577,"line":653},[575,967,957],{"class":607},[575,969,960],{"class":581},[575,971,972],{"class":607}," OSD\n",[575,974,975,977,979],{"class":577,"line":660},[575,976,957],{"class":607},[575,978,960],{"class":581},[575,980,981],{"class":607}," MDS\n",[575,983,984,986,988],{"class":577,"line":677},[575,985,957],{"class":607},[575,987,960],{"class":581},[575,989,990],{"class":607}," RGW\n",[514,992,993],{},"The MGR daemon(s) have many modules to for example provide metrics for Prometheus, Zabbix and others. In addition to that a Ceph dashboard can be activated which contains some basic information and even an integration with Prometheus and Grafana.",[514,995,996,809,998],{},[724,997,808],{},[811,999,1000],{"href":1000,"rel":1001},"https:\u002F\u002Fdocs.ceph.com\u002Fen\u002Flatest\u002Fmgr\u002Findex.html",[815],[558,1003,1005],{"id":1004},"osd-object-storage-daemon","OSD - Object Storage Daemon",[514,1007,1008],{},"All OSDs normally talk with each other for hearbeat ❤️ checking and data replication (actual data and also for data \"scrubbing\" operations).",[563,1010,1011],{},[566,1012,1014],{"className":568,"code":1013,"language":563,"meta":570,"style":570},"---\nconfig:\n  layout: elk\n---\ngraph LR\n    OSD-0\n    OSD-0 -.- OSD-1\n    OSD-0 -.- OSD-2\n    OSD-0 -.- OSD-n\n\n    OSD-1\n    OSD-1 -.- OSD-0\n    OSD-1 -.- OSD-2\n    OSD-1 -.- OSD-n\n\n    OSD-2\n    OSD-2 -.- OSD-0\n    OSD-2 -.- OSD-1\n    OSD-2 -.- OSD-n\n\n    OSD-n\n    OSD-n -.- OSD-0\n    OSD-n -.- OSD-1\n    OSD-n -.- OSD-2\n",[572,1015,1016,1020,1024,1028,1032,1038,1043,1053,1062,1071,1075,1080,1090,1099,1108,1113,1119,1129,1138,1147,1152,1158,1168,1177],{"__ignoreMap":570},[575,1017,1018],{"class":577,"line":578},[575,1019,932],{"class":607},[575,1021,1022],{"class":577,"line":589},[575,1023,937],{"class":607},[575,1025,1026],{"class":577,"line":598},[575,1027,942],{"class":607},[575,1029,1030],{"class":577,"line":621},[575,1031,932],{"class":607},[575,1033,1034,1036],{"class":577,"line":634},[575,1035,582],{"class":581},[575,1037,586],{"class":585},[575,1039,1040],{"class":577,"line":647},[575,1041,1042],{"class":607},"    OSD-0\n",[575,1044,1045,1048,1050],{"class":577,"line":653},[575,1046,1047],{"class":607},"    OSD-0 ",[575,1049,791],{"class":581},[575,1051,1052],{"class":607}," OSD-1\n",[575,1054,1055,1057,1059],{"class":577,"line":660},[575,1056,1047],{"class":607},[575,1058,791],{"class":581},[575,1060,1061],{"class":607}," OSD-2\n",[575,1063,1064,1066,1068],{"class":577,"line":677},[575,1065,1047],{"class":607},[575,1067,791],{"class":581},[575,1069,1070],{"class":607}," OSD-n\n",[575,1072,1073],{"class":577,"line":690},[575,1074,657],{"emptyLinePlaceholder":656},[575,1076,1077],{"class":577,"line":703},[575,1078,1079],{"class":607},"    OSD-1\n",[575,1081,1082,1085,1087],{"class":577,"line":708},[575,1083,1084],{"class":607},"    OSD-1 ",[575,1086,791],{"class":581},[575,1088,1089],{"class":607}," OSD-0\n",[575,1091,1093,1095,1097],{"class":577,"line":1092},13,[575,1094,1084],{"class":607},[575,1096,791],{"class":581},[575,1098,1061],{"class":607},[575,1100,1102,1104,1106],{"class":577,"line":1101},14,[575,1103,1084],{"class":607},[575,1105,791],{"class":581},[575,1107,1070],{"class":607},[575,1109,1111],{"class":577,"line":1110},15,[575,1112,657],{"emptyLinePlaceholder":656},[575,1114,1116],{"class":577,"line":1115},16,[575,1117,1118],{"class":607},"    OSD-2\n",[575,1120,1122,1125,1127],{"class":577,"line":1121},17,[575,1123,1124],{"class":607},"    OSD-2 ",[575,1126,791],{"class":581},[575,1128,1089],{"class":607},[575,1130,1132,1134,1136],{"class":577,"line":1131},18,[575,1133,1124],{"class":607},[575,1135,791],{"class":581},[575,1137,1052],{"class":607},[575,1139,1141,1143,1145],{"class":577,"line":1140},19,[575,1142,1124],{"class":607},[575,1144,791],{"class":581},[575,1146,1070],{"class":607},[575,1148,1150],{"class":577,"line":1149},20,[575,1151,657],{"emptyLinePlaceholder":656},[575,1153,1155],{"class":577,"line":1154},21,[575,1156,1157],{"class":607},"    OSD-n\n",[575,1159,1161,1164,1166],{"class":577,"line":1160},22,[575,1162,1163],{"class":607},"    OSD-n ",[575,1165,791],{"class":581},[575,1167,1089],{"class":607},[575,1169,1171,1173,1175],{"class":577,"line":1170},23,[575,1172,1163],{"class":607},[575,1174,791],{"class":581},[575,1176,1052],{"class":607},[575,1178,1180,1182,1184],{"class":577,"line":1179},24,[575,1181,1163],{"class":607},[575,1183,791],{"class":581},[575,1185,1061],{"class":607},[523,1187,1188,1191,1194],{},[526,1189,1190],{},"If a client writes data, the data is replicated by the OSD and not the client.",[526,1192,1193],{},"If a client reads data, the data can be read from multiple OSDs at the same time (as long as they have a replica of the data).",[526,1195,1196,809,1199],{},[724,1197,1198],{},"Side note",[1200,1201,1202],"em",{},"That is the reason why read speeds are so fast and writes can be so slow. One slow OSD can \"ruin your day\" because of that.",[514,1204,1205,809,1207],{},[724,1206,808],{},[811,1208,1209],{"href":1209,"rel":1210},"https:\u002F\u002Fdocs.ceph.com\u002Fen\u002Flatest\u002Fman\u002F8\u002Fceph-osd\u002F",[815],[558,1212,1214],{"id":1213},"mds-metadata-server-daemon","MDS - Metadata Server Daemon",[514,1216,1217],{},"The MDS is the metadata server for the CephFilesystem (CephFS).",[514,1219,1220],{},"It talks with the OSDs and coordinates the filesystem access. Clients still need to access the OSDs, but the MDS is the \"gateway\" to know where to go so to say.",[563,1222,1223],{},[566,1224,1226],{"className":568,"code":1225,"language":563,"meta":570,"style":570},"---\nconfig:\n  layout: elk\n---\ngraph LR\n    Client-A --> MDS-1\n    Client-B --> MDS-1\n    Client-C ---> MDS-2\n\n    MDS-1 -.- MDS-2\n    MDS-1 --> OSDs\n    MDS-2 --> OSDs\n\n    Client-A ---> OSDs\n    Client-B ---> OSDs\n    Client-C ---> OSDs\n",[572,1227,1228,1232,1236,1240,1244,1250,1260,1269,1280,1284,1293,1302,1311,1315,1323,1331],{"__ignoreMap":570},[575,1229,1230],{"class":577,"line":578},[575,1231,932],{"class":607},[575,1233,1234],{"class":577,"line":589},[575,1235,937],{"class":607},[575,1237,1238],{"class":577,"line":598},[575,1239,942],{"class":607},[575,1241,1242],{"class":577,"line":621},[575,1243,932],{"class":607},[575,1245,1246,1248],{"class":577,"line":634},[575,1247,582],{"class":581},[575,1249,586],{"class":585},[575,1251,1252,1255,1257],{"class":577,"line":647},[575,1253,1254],{"class":607},"    Client-A ",[575,1256,960],{"class":581},[575,1258,1259],{"class":607}," MDS-1\n",[575,1261,1262,1265,1267],{"class":577,"line":653},[575,1263,1264],{"class":607},"    Client-B ",[575,1266,960],{"class":581},[575,1268,1259],{"class":607},[575,1270,1271,1274,1277],{"class":577,"line":660},[575,1272,1273],{"class":607},"    Client-C ",[575,1275,1276],{"class":581},"--->",[575,1278,1279],{"class":607}," MDS-2\n",[575,1281,1282],{"class":577,"line":677},[575,1283,657],{"emptyLinePlaceholder":656},[575,1285,1286,1289,1291],{"class":577,"line":690},[575,1287,1288],{"class":607},"    MDS-1 ",[575,1290,791],{"class":581},[575,1292,1279],{"class":607},[575,1294,1295,1297,1299],{"class":577,"line":703},[575,1296,1288],{"class":607},[575,1298,960],{"class":581},[575,1300,1301],{"class":607}," OSDs\n",[575,1303,1304,1307,1309],{"class":577,"line":708},[575,1305,1306],{"class":607},"    MDS-2 ",[575,1308,960],{"class":581},[575,1310,1301],{"class":607},[575,1312,1313],{"class":577,"line":1092},[575,1314,657],{"emptyLinePlaceholder":656},[575,1316,1317,1319,1321],{"class":577,"line":1101},[575,1318,1254],{"class":607},[575,1320,1276],{"class":581},[575,1322,1301],{"class":607},[575,1324,1325,1327,1329],{"class":577,"line":1110},[575,1326,1264],{"class":607},[575,1328,1276],{"class":581},[575,1330,1301],{"class":607},[575,1332,1333,1335,1337],{"class":577,"line":1115},[575,1334,1273],{"class":607},[575,1336,1276],{"class":581},[575,1338,1301],{"class":607},[514,1340,1341,809,1343],{},[724,1342,808],{},[811,1344,1345],{"href":1345,"rel":1346},"https:\u002F\u002Fdocs.ceph.com\u002Fen\u002Flatest\u002Fman\u002F8\u002Fceph-mds\u002F",[815],[558,1348,1350],{"id":1349},"rgw-rados-rest-gateway","RGW - RADOS REST Gateway",[514,1352,1353],{},"RGW can offer S3 and\u002F or SWIFT compatible storage, allowing to use it as a \"replacement\" for AWS S3 object storage in some cases.\nAn advantage to, e.g., the block storage (RBD) and CephFS is that the client itself does not need direct access to the MONs, OSDs, etc., though it depends on the use case and the performance required per client\u002F application.",[563,1355,1356],{},[566,1357,1359],{"className":568,"code":1358,"language":563,"meta":570,"style":570},"---\nconfig:\n  layout: elk\n---\ngraph LR\n    Client-A --> RGW-1\n    Client-B --> RGW-1\n    Client-C --> RGW-2\n    RGW-1 --> OSDs\n    RGW-2 --> OSDs\n",[572,1360,1361,1365,1369,1373,1377,1383,1392,1400,1409,1418],{"__ignoreMap":570},[575,1362,1363],{"class":577,"line":578},[575,1364,932],{"class":607},[575,1366,1367],{"class":577,"line":589},[575,1368,937],{"class":607},[575,1370,1371],{"class":577,"line":598},[575,1372,942],{"class":607},[575,1374,1375],{"class":577,"line":621},[575,1376,932],{"class":607},[575,1378,1379,1381],{"class":577,"line":634},[575,1380,582],{"class":581},[575,1382,586],{"class":585},[575,1384,1385,1387,1389],{"class":577,"line":647},[575,1386,1254],{"class":607},[575,1388,960],{"class":581},[575,1390,1391],{"class":607}," RGW-1\n",[575,1393,1394,1396,1398],{"class":577,"line":653},[575,1395,1264],{"class":607},[575,1397,960],{"class":581},[575,1399,1391],{"class":607},[575,1401,1402,1404,1406],{"class":577,"line":660},[575,1403,1273],{"class":607},[575,1405,960],{"class":581},[575,1407,1408],{"class":607}," RGW-2\n",[575,1410,1411,1414,1416],{"class":577,"line":677},[575,1412,1413],{"class":607},"    RGW-1 ",[575,1415,960],{"class":581},[575,1417,1301],{"class":607},[575,1419,1420,1423,1425],{"class":577,"line":690},[575,1421,1422],{"class":607},"    RGW-2 ",[575,1424,960],{"class":581},[575,1426,1301],{"class":607},[514,1428,1429],{},"Common scenario is that you have a load balancer in front of your RGWs, in itself the structure stays the same:",[563,1431,1432],{},[566,1433,1435],{"className":568,"code":1434,"language":563,"meta":570,"style":570},"---\nconfig:\n  layout: elk\n---\ngraph LR\n    Client-A --> Loadbalancer\n    Client-B --> Loadbalancer\n    Client-C --> Loadbalancer\n    Loadbalancer --> RGW-1\n    Loadbalancer --> RGW-2\n    RGW-1 --> OSDs\n    RGW-2 --> OSDs\n",[572,1436,1437,1441,1445,1449,1453,1459,1468,1476,1484,1493,1501,1509],{"__ignoreMap":570},[575,1438,1439],{"class":577,"line":578},[575,1440,932],{"class":607},[575,1442,1443],{"class":577,"line":589},[575,1444,937],{"class":607},[575,1446,1447],{"class":577,"line":598},[575,1448,942],{"class":607},[575,1450,1451],{"class":577,"line":621},[575,1452,932],{"class":607},[575,1454,1455,1457],{"class":577,"line":634},[575,1456,582],{"class":581},[575,1458,586],{"class":585},[575,1460,1461,1463,1465],{"class":577,"line":647},[575,1462,1254],{"class":607},[575,1464,960],{"class":581},[575,1466,1467],{"class":607}," Loadbalancer\n",[575,1469,1470,1472,1474],{"class":577,"line":653},[575,1471,1264],{"class":607},[575,1473,960],{"class":581},[575,1475,1467],{"class":607},[575,1477,1478,1480,1482],{"class":577,"line":660},[575,1479,1273],{"class":607},[575,1481,960],{"class":581},[575,1483,1467],{"class":607},[575,1485,1486,1489,1491],{"class":577,"line":677},[575,1487,1488],{"class":607},"    Loadbalancer ",[575,1490,960],{"class":581},[575,1492,1391],{"class":607},[575,1494,1495,1497,1499],{"class":577,"line":690},[575,1496,1488],{"class":607},[575,1498,960],{"class":581},[575,1500,1408],{"class":607},[575,1502,1503,1505,1507],{"class":577,"line":703},[575,1504,1413],{"class":607},[575,1506,960],{"class":581},[575,1508,1301],{"class":607},[575,1510,1511,1513,1515],{"class":577,"line":708},[575,1512,1422],{"class":607},[575,1514,960],{"class":581},[575,1516,1301],{"class":607},[514,1518,1519,809,1521],{},[724,1520,808],{},[811,1522,1523],{"href":1523,"rel":1524},"https:\u002F\u002Fdocs.ceph.com\u002Fen\u002Flatest\u002Fman\u002F8\u002Fradosgw\u002F",[815],[1526,1527],"hr",{},[514,1529,1530,1535,1536,1541],{},[811,1531,1534],{"href":1532,"rel":1533},"https:\u002F\u002Fgithub.com\u002FTheJJ\u002Fceph-cheatsheet",[815],"This wonderful Ceph cheat sheet"," from ",[811,1537,1540],{"href":1538,"rel":1539},"https:\u002F\u002Fgithub.com\u002FTheJJ",[815],"@TheJJ on GitHub"," has much more insight into the processes, tricks and setup of a Ceph cluster and the moving parts.",[1526,1543],{},[518,1545,1547],{"id":1546},"old-diagrams","Old Diagrams",[514,1549,1550],{},[1200,1551,1552,1553,1556],{},"The source for the diagrams, can be found as ",[572,1554,1555],{},".graphml"," at the same path as the images.",[558,1558,1560],{"id":1559},"basic-cluster-with-hdds-and-ssds","Basic Cluster with HDDs and SSDs",[514,1562,1563],{},[1564,1565],"img",{"alt":1566,"src":1567},"ceph-architecture-cluster-basic-hdds-ssds.png","\u002Fdocs\u002Fstorage\u002Fceph\u002Farchitecture\u002Fceph-architecture-cluster-basic-hdds-ssds.png",[558,1569,1571],{"id":1570},"cluster-with-rgw-for-s3-compatible-object-storage","Cluster with RGW for S3-compatible Object Storage",[514,1573,1574],{},"No direct OSD access network is required by the consumers of the object storage.\nThis can be seen as a \"advantage\" over RBD a