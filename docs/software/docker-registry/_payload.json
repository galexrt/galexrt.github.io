[{"data":1,"prerenderedAt":748,"buildId":749},["ShallowReactive",2],{"\u002Fdocs\u002Fsoftware\u002Fdocker-registry":3,"\u002Fdocs\u002Fsoftware\u002Fdocker-registry-surround":233,"navigation":242},{"id":4,"title":5,"body":6,"description":98,"extension":225,"meta":226,"navigation":228,"path":229,"seo":230,"stem":231,"__hash__":232},"docs\u002F1.docs\u002Fsoftware\u002Fdocker-registry.md","Docker Registry",{"type":7,"value":8,"toc":221},"minimark",[9,14,18,34,56,63,69,85,92,157,161,168,203,217],[10,11,13],"h2",{"id":12},"garbage-collection-doesnt-work-with-non-aws-s3-stores","Garbage Collection doesn't work with non AWS S3 stores",[15,16,17],"p",{},"(Non AWS S3 stores, e.g., Ceph RGW, Minio, Linode Object store and other similar stores)",[15,19,20,21,33],{},"This is due to ",[22,23,27,28,32],"a",{"href":24,"rel":25},"https:\u002F\u002Fgithub.com\u002Fdocker\u002Fdistribution\u002Fissues\u002F3200",[26],"nofollow","GitHub docker\u002Fdistribution - Issue ",[29,30,31],"code",{},"failed to garbage collect"," #3200",".",[35,36,38],"callout",{"icon":37},"i-ph-lightbulb-filament",[15,39,40,44,45,50,51,33],{},[41,42,43],"strong",{},"Note",":\nThis workaround\u002F \"fix\" is based on ",[22,46,49],{"href":47,"rel":48},"https:\u002F\u002Fgithub.com\u002Fthomasf",[26],"@thomasf (Thomas Frössman)","'s ",[22,52,55],{"href":53,"rel":54},"https:\u002F\u002Fgithub.com\u002Fdocker\u002Fdistribution\u002Fissues\u002F3200#issuecomment-671062638",[26],"comment in the issue",[15,57,58,59,62],{},"There is an issue in the ",[29,60,61],{},"s3aws.Walk()"," function which fails for (most) non AWS S3 storages.",[15,64,65,66,33],{},"To make the garbage collection work, an empty file needs to be created in the bucket at the following path (default S3 bucket settings used in the docker-registry itself) ",[29,67,68],{},"BUCKET_NAME\u002Fdocker\u002Fregistry\u002Fv2\u002Frepositories\u002F",[35,70,71],{"icon":37},[15,72,73,76,77,80,81,84],{},[41,74,75],{},"Info",":\nReplace the placeholders (",[29,78,79],{},"MC_HOST_CONFIG_NAME",", ",[29,82,83],{},"BUCKET_NAME",") according to your docker-registry S3 storage configuration.",[15,86,87,88,91],{},"Using the Minio client ",[29,89,90],{},"mc"," (compatible with most\u002F all S3 based storages) the following command should \"fix\" the issue:",[93,94,99],"pre",{"className":95,"code":96,"language":97,"meta":98,"style":98},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","# Create empty file\ntouch workaround_s3aws_walk_issue_github_docker_distribtuion_issue_3200\n# Upload the empty file\nmc cp workaround_s3aws_walk_issue_github_docker_distribtuion_issue_3200 MC_HOST_CONFIG_NAME\u002FBUCKET_NAME\u002Fdocker\u002Fregistry\u002Fv2\u002Frepositories\u002F\n# Verify that the file has been uploaded\nmc ls MC_HOST_CONFIG_NAME\u002FBUCKET_NAME\u002Fdocker\u002Fregistry\u002Fv2\u002Frepositories\u002F\n","bash","",[29,100,101,110,121,127,141,147],{"__ignoreMap":98},[102,103,106],"span",{"class":104,"line":105},"line",1,[102,107,109],{"class":108},"sHwdD","# Create empty file\n",[102,111,113,117],{"class":104,"line":112},2,[102,114,116],{"class":115},"sBMFI","touch",[102,118,120],{"class":119},"sfazB"," workaround_s3aws_walk_issue_github_docker_distribtuion_issue_3200\n",[102,122,124],{"class":104,"line":123},3,[102,125,126],{"class":108},"# Upload the empty file\n",[102,128,130,132,135,138],{"class":104,"line":129},4,[102,131,90],{"class":115},[102,133,134],{"class":119}," cp",[102,136,137],{"class":119}," workaround_s3aws_walk_issue_github_docker_distribtuion_issue_3200",[102,139,140],{"class":119}," MC_HOST_CONFIG_NAME\u002FBUCKET_NAME\u002Fdocker\u002Fregistry\u002Fv2\u002Frepositories\u002F\n",[102,142,144],{"class":104,"line":143},5,[102,145,146],{"class":108},"# Verify that the file has been uploaded\n",[102,148,150,152,155],{"class":104,"line":149},6,[102,151,90],{"class":115},[102,153,154],{"class":119}," ls",[102,156,140],{"class":119},[10,158,160],{"id":159},"configuration-through-environment-variables-fails","Configuration through Environment Variables Fails",[15,162,163,164,167],{},"Sometimes when \"deeply nesting\" environment variables to configure a certain aspect of the docker-registry configuration, e.g., ",[29,165,166],{},"REGISTRY_STORAGE_MAINTENANCE_READONLY_ENABLED",", need to be specified as YAML or JSON starting from \"a few levels\" further below of the config structure:",[93,169,173],{"className":170,"code":171,"language":172,"meta":98,"style":98},"language-yaml shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","REGISTRY_STORAGE_MAINTENANCE: |-\n  uploadpurging:\n    enabled: false\n","yaml",[29,174,175,193,198],{"__ignoreMap":98},[102,176,177,181,185,189],{"class":104,"line":105},[102,178,180],{"class":179},"swJcz","REGISTRY_STORAGE_MAINTENANCE",[102,182,184],{"class":183},"sMK4o",":",[102,186,188],{"class":187},"s7zQu"," |",[102,190,192],{"class":191},"spNyl","-\n",[102,194,195],{"class":104,"line":112},[102,196,197],{"class":119},"  uploadpurging:\n",[102,199,200],{"class":104,"line":123},[102,201,202],{"class":119},"    enabled: false\n",[15,204,205,206,211,212,33],{},"This has been posted for a similar config situation by ",[22,207,210],{"href":208,"rel":209},"https:\u002F\u002Fgithub.com\u002F0rax",[26],"@0rax"," in ",[22,213,216],{"href":214,"rel":215},"https:\u002F\u002Fgithub.com\u002Fdocker\u002Fdistribution\u002Fissues\u002F1736#issuecomment-435362014",[26],"GitHub docker\u002Fdistribution - Registry - Upload purging environment overrides crash registry at startup Issue #1736",[218,219,220],"style",{},"html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.sh