[{"data":1,"prerenderedAt":628,"buildId":629},["ShallowReactive",2],{"\u002Fdocs\u002Fsoftware\u002Fcrio":3,"\u002Fdocs\u002Fsoftware\u002Fcrio-surround":113,"navigation":122},{"id":4,"title":5,"body":6,"description":79,"extension":106,"meta":107,"navigation":108,"path":109,"seo":110,"stem":111,"__hash__":112},"docs\u002F1.docs\u002Fsoftware\u002Fcrio.md","CRI-O",{"type":7,"value":8,"toc":102},"minimark",[9,14,26,34,37,51,98],[10,11,13],"h2",{"id":12},"default-cni-configs-causes-cluster-network-issues","Default CNI configs causes Cluster Network Issues",[15,16,18],"callout",{"icon":17},"i-ph-lightbulb-filament",[19,20,21,25],"p",{},[22,23,24],"strong",{},"Info",":\nIf you use CRI-O with Kubernetes, you should always remove these default CNI config files!",[19,27,28,29,33],{},"On most operating systems where CRI-O can be installed through a packge, CRI-O comes with some default CNI configs located at ",[30,31,32],"code",{},"\u002Fetc\u002Fcni\u002Fnet.d\u002F"," (default directory).\nThat means if you run Kubernetes or anything else that \"brings its own CNI\" (e.g., Calico, Cilium, Flannel, etc.) you need to remove those files.",[19,35,36],{},"Currently it should be those two files that need to be removed:",[38,39,40,46],"ul",{},[41,42,43],"li",{},[30,44,45],{},"\u002Fetc\u002Fcni\u002Fnet.d\u002F100-crio-bridge.conf",[41,47,48],{},[30,49,50],{},"\u002Fetc\u002Fcni\u002Fnet.d\u002F200-loopback.conf",[15,52,53,63,73],{"icon":17},[19,54,55,58,59,62],{},[22,56,57],{},"Tip",":\nIf CRI-O was already running\u002Fstarted at the time of removing these CNI config files, you need to restart the ",[30,60,61],{},"crio"," service on the server(s).",[19,64,65,66,69,70,72],{},"Using ",[30,67,68],{},"sudo"," or as the root user run the following to restart the ",[30,71,61],{}," service on servers that use systemd as the \"service manager\":",[74,75,80],"pre",{"className":76,"code":77,"language":78,"meta":79,"style":79},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","systemctl restart crio\n","bash","",[30,81,82],{"__ignoreMap":79},[83,84,87,91,95],"span",{"class":85,"line":86},"line",1,[83,88,90],{"class":89},"sBMFI","systemctl",[83,92,94],{"class":93},"sfazB"," restart",[83,96,97],{"class":93}," crio\n",[99,100,101],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":79,"searchDepth":103,"depth":103,"links":104},2,[105],{"id":12,"depth":103,"text":13},"md",{},true,"\u0