809,811],{"class":577,"line":810},23,[575,812,654],{"class":605},[533,814,816],{"id":815},"esphome-config","ESPHome Config",[566,818,822],{"className":819,"code":820,"language":821,"meta":570,"style":570},"language-yaml shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","esphome:\n  name: my-door-bell\n  friendly_name: \"My Door Bell\"\n\nesp32:\n  board: esp32dev\n  framework:\n    type: arduino\n\n# Enable logging\nlogger:\n  level: WARN\n\n# Enable Home Assistant API\napi:\n  encryption:\n    key: \"YOUR_HASSIO_API_ENCRYPTION_KEY\"\n\nota:\n  - platform: esphome\n    password: \"YOUR_OTA_PASSWORD\"\n\nwifi:\n  ssid: !secret wifi_ssid\n  password: !secret wifi_password\n \nbinary_sensor:\n  - platform: template\n    name: \"My Door Bell\"\n    id: my_door_bell\n    icon: \"mdi:doorbell\"\n    # If you know a better device class for this use case, please let me know :-D\n    device_class: power\n    publish_initial_state: True\n\nsensor:\n  - platform: adc\n    pin: GPIO36\n    name: \"My Door Bell\"\n    id: \"my_door_bell_voltage\"\n    update_interval: 0.15s\n    internal: true\n    attenuation: 12db\n    filters:\n      - multiply: 3.3\n    on_value_range:\n      above: 4.18\n      then:\n        if:\n          condition:\n            binary_sensor.is_off: my_door_bell\n          then:\n            - binary_sensor.template.publish:\n                id: my_door_bell\n                state: on\n            - delay: 6s\n            - binary_sensor.template.publish:\n                id: my_door_bell\n                state: off\n","yaml",[572,823,824,834,845,861,865,872,882,889,899,903,909,916,926,930,935,942,949,963,967,974,987,1001,1005,1012,1027,1040,1046,1054,1066,1080,1091,1106,1112,1123,1135,1140,1148,1160,1171,1184,1198,1209,1220,1231,1239,1254,1262,1273,1281,1289,1297,1307,1315,1326,1336,1347,1360,1369,1378],{"__ignoreMap":570},[575,825,826,830],{"class":577,"line":578},[575,827,829],{"class":828},"swJcz","esphome",[575,831,83