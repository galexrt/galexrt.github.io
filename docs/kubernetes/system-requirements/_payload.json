[{"data":1,"prerenderedAt":620,"buildId":621},["ShallowReactive",2],{"\u002Fdocs\u002Fkubernetes\u002Fsystem-requirements":3,"\u002Fdocs\u002Fkubernetes\u002Fsystem-requirements-surround":107,"navigation":116},{"id":4,"title":5,"body":6,"description":92,"extension":100,"meta":101,"navigation":102,"path":103,"seo":104,"stem":105,"__hash__":106},"docs\u002F1.docs\u002Fkubernetes\u002Fsystem-requirements.md","System Requirements",{"type":7,"value":8,"toc":91},"minimark",[9,25,30,33,43,55,59,64,84],[10,11,13],"callout",{"icon":12},"i-ph-lightbulb-filament",[14,15,16,20,21,24],"p",{},[17,18,19],"strong",{},"Tip",": Recommendations for Requirements\nThese are ",[17,22,23],{},"recommendations"," for requirements of Kubernetes Masters and Nodes.",[26,27,29],"h2",{"id":28},"general","General",[14,31,32],{},"Network:",[34,35,36],"ul",{},[37,38,39,42],"li",{},[17,40,41],{},"Bandwidth",": at the very least 1G, recommended for smaller, lower traffic environents is 10G, 25G or more.",[10,44,45],{"icon":12},[14,46,47,50,51,54],{},[17,48,49],{},"Info",":\nTo reduce costs you can get away with just having ",[17,52,53],{},"a single interface",", instead of, e.g., 2 interfaces being bonded together (it also reduces complexity).",[26,56,58],{"id":57},"master","Master",[60,61,63],"h3",{"id":62},"storage","Storage",[10,65,66,76,79],{"icon":12},[14,67,68,71,72,75],{},[17,69,70],{},"Warning",":\n\"SSDs or even NVMe based storage is more expensive but your ETCD will love and need it!\"\n",[17,73,74],{},"DO NOT USE"," HDDs nor any kind of networked storage for ETCD!",[14,77,78],{},"Even a fast Ceph RBD (e.g., when running in VMs) can look good in the beginning but might \"kill\" the ETCD performance in the end!",[14,80,81],{},[17,82,83],{},"Too many users of Kubernetes or OpenShift do that and end up with slow performing clusters in many different ways, simply because the ETCD is slow (even though the kube-apiservers are caching a lot)",[14,85,86,87,90],{},"Use at least SSDs (minimum SATA based, better NVMe based) or any other storage with ",[17,88,89],{},"low latencies","! ETCD is pretty much latency bound. It needs \"few\" IOPS but latency is the killer (sequential writing, e.g., WAL and DB).",{"title":92,"searchDepth":93,"depth":93,"links":94},"",2,[95,96],{"id":28,"depth":93,"text":29},{"id":57,"depth":93,"text":58,"children":97},[98],{"id":62,"depth":99,"text":63},3,"md",{},true,"\u002Fdocs\u002Fkubernetes\u002Fsystem-requirements",{"title":5,"description":92},"1.docs\u002Fkubernetes\u002Fsystem-requirements","XZdwXnWG33HVE2RYLZynGLYXGUXjc6d6AnomAAGL9tg",[108,112],{"title":109,"path":110,"stem":111,"description":92,"children":-1},"Troubleshooting","\u002Fdocs\u002Fkubernetes\u002Fnetworking\u002Ftroubleshooting","1.docs\u002Fkubernetes\u002Fnetworking\u002Ftroubleshooting",{"title":113,"path":114,"stem":115,"description":92,"children":-1},"git","\u002Fdocs\u002Flinux\u002Fgit","1.docs\u002Flinux\u002Fgit",[117],{"title":118,"icon":119,"path":120,"stem":121,"children":122},"Docs","i-ph-book-open","\u002Fdocs","1.docs",[123,125,136,176,186,211,235,320,382,390,429,439,507,533,594],{"title":118,"path":120,"stem":124},"1.docs\u002Findex",{"icon":126,"title":127,"path":128,"stem":129,"children":130,"page":135},"i-ph-coffee-bean","Coffee","\u002Fdocs\u002Fcoffee","1.docs\u002Fcoffee",[131],{"title":132,"path":133,"stem":134},"Shops","\u002Fdocs\u002Fcoffee\u002Fshops","1.docs\u002Fcoffee\u002Fshops",false,{"icon":137,"title":138,"path":139,"stem":140,"children":141,"page":135},"i-ph-database","Databases","\u002Fdocs\u002Fdatabases","1.docs\u002Fdatabases",[142,146],{"title":143,"path":144,"stem":145},"MongoDB","\u002Fdocs\u002Fdatabases\u002Fmongodb","1.docs\u002Fdatabases\u002Fmongodb",{"title":147,"icon":148,"path":149,"stem":150,"children":151,"page":135},"MySQL","i-simple-icons-mysql","\u002Fdocs\u002Fdatabases\u002Fmysql","1.docs\u002Fdatabases\u002Fmysql",[152,156,160,164,168,172],{"title":153,"path":154,"stem":155},"Cheat Sheet","\u002Fdocs\u002Fd