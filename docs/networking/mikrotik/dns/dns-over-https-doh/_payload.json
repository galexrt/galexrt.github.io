ain name",[15,84,85,86,92],{},"In this guide I will be using Cloudflare \"Block malware\" DoH server,",[87,88,89],"a",{"href":89,"rel":90},"https:\u002F\u002Fdevelopers.cloudflare.com\u002F1.1.1.1\u002Fsetup\u002F#dns-over-https-doh",[91],"nofollow",", in the end the process is the same for any DoH domain name.",[15,94,95,96,99,100,103,104,107],{},"Resolve the domain name, e.g., ",[26,97,98],{},"security.cloudflare-dns.com"," , using a tool such as ",[26,101,102],{},"nslookup IP_ADDRESS"," , ",[26,105,106],{},"host IP_ADDRESS"," to get the IP addresses behind that domain name.",[19,109,111],{"className":21,"code":110,"language":23,"meta":24,"style":24},"$ host security.cloudflare-dns.com\nsecurity.cloudflare-dns.com has address 1.1.1.2\nsecurity.cloudflare-dns.com has address 1.0.0.2\nsecurity.cloudflare-dns.com has IPv6 address 2606:4700:4700::1112\nsecurity.cloudflare-dns.com has IPv6 address 2606:4700:4700::1002\n",[26,112,113,135,162,186,222],{"__ignoreMap":24},[29,114,115,118,121,124,127,130,132],{"class":31,"line":32},[29,116,117],{"class":35},"$ host security",[29,119,120],{"class":42},".",[29,122,123],{"class":35},"cloudflare",[29,125,126],{"class":42},"-",[29,128,129],{"class":35},"dns",[29,131,120],{"class":42},[29,133,134],{"class":35},"com\n",[29,136,137,140,142,144,146,148,150,153,157,159],{"class":31,"line":39},[29,138,139],{"class":35},"security",[29,141,120],{"class":42},[29,143,123],{"class":35},[29,145,126],{"class":42},[29,147,129],{"class":35},[29,149,120],{"class":42},[29,151,152],{"class":35},"com has address ",[29,154,156],{"class":155},"sbssI","1.1",[29,158,120],{"class":42},[29,160,161],{"class":155},"1.2\n",[29,163,164,166,168,170,172,174,176,178,181,183],{"class":31,"line":63},[29,165,139],{"class":35},[29,167,120],{"class":42},[29,169,123],{"class":35},[29,171,126],{"class":42},[29,173,129],{"class":35},[29,175,120],{"class":42},[29,177,152],{"class":35},[29,179,180],{"class":155},"1.0",[29,182,120],{"class":42},[29,184,185],{"class":155}