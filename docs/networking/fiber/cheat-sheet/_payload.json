[{"data":1,"prerenderedAt":585,"buildId":586},["ShallowReactive",2],{"\u002Fdocs\u002Fnetworking\u002Ffiber\u002Fcheat-sheet":3,"\u002Fdocs\u002Fnetworking\u002Ffiber\u002Fcheat-sheet-surround":70,"navigation":79},{"id":4,"title":5,"body":6,"description":56,"extension":62,"meta":63,"navigation":65,"path":66,"seo":67,"stem":68,"__hash__":69},"docs\u002F1.docs\u002Fnetworking\u002Ffiber\u002Fcheat-sheet.md","Cheat Sheet",{"type":7,"value":8,"toc":55},"minimark",[9,14,18,29,33,40,44,47,52],[10,11,13],"h2",{"id":12},"rj45-copper-t-base-sfp-sfp","RJ45 (Copper) T-Base SFP\u002F SFP+",[15,16,17],"p",{},"As long as they support one of the T-Base standards (e.g., 1000T-Base), they should be able to be used like a \"normal RJ45 ethernet network\" port.",[19,20,22],"callout",{"icon":21},"i-ph-lightbulb-filament",[15,23,24,28],{},[25,26,27],"strong",{},"Info",": T-Base standard\nFor the SFP\u002F SFP+ to work with, e.g, 10\u002F 100\u002F 1000, each of the nT-Base standards must be \"implemented\" in them.",[10,30,32],{"id":31},"simplex-and-multimode-fiber-cables-and-transceivers","Simplex and Multimode fiber cables and transceivers",[15,34,35,36,39],{},"You should ",[25,37,38],{},"not"," mix simplex with multimode fibers and transceivers, and the other way around.",[10,41,43],{"id":42},"youll-never-have-a-second-go-for-apc-connectors","\"You'll never have a second go for APC connectors\"",[15,45,46],{},"Due to the polishing (angle 8°) of APC fiber \"ends\", if you plugin the fiber connector the wrong way, you'll \"break\" them (slight crunch noise).\nE.g., plugging SC APC connectors in the wrong way.",[15,48,49],{},[25,50,51],{},"Make sure to check the orientation markers and with that always plug APC connectors in the correct way!",[15,53,54],{},"UPC connectors are having no polish at all so no need to worry about the way to plug them in.",{"title":56,"searchDepth":57,"depth":57,"links":58},"",2,[59,60,61],{"id":12,"depth":57,"text":13},{"id":31,"depth":57,"text":32},{"id":42