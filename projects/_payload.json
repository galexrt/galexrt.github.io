[{"data":1,"prerenderedAt":697,"buildId":698},["ShallowReactive",2],{"\u002Fprojects":3,"navigation":182},{"id":4,"title":5,"authors":6,"body":7,"description":13,"extension":174,"meta":175,"navigation":177,"path":178,"seo":179,"stem":180,"__hash__":181},"content\u002F6.projects.md","Projects",null,{"type":8,"value":9,"toc":159},"minimark",[10,14,19,22,26,29,32,56,60,63,66,82,86,89,92,95,106,110,113,129,133,137,140,144,147,151],[11,12,13],"p",{},"These are some of the companies and projects I have worked and\u002F or am still working on:",[15,16,18],"h2",{"id":17},"koor-technologies-inc-founding-engineer","Koor Technologies, Inc. - Founding Engineer",[11,20,21],{},"I'm the Founding Engineer of Koor Technologies, Inc. An open source company which has been funded by Open Core Ventures.\nWe are working towards creating a simpler way of deploying containerized storage using open source technologies Rook and Ceph.",[15,23,25],{"id":24},"rook-maintainer","Rook - Maintainer",[11,27,28],{},"Rook is an open source cloud-native storage orchestrator, providing the platform, framework, and support for a diverse set of storage solutions to natively integrate with cloud-native environments.",[11,30,31],{},"I am a maintainer of the Rook project.",[33,34,35],"callout",{},[11,36,37,41,42,48,49,41,52],{},[38,39,40],"strong",{},"GitHub",": ",[43,44,45],"a",{"href":45,"rel":46},"https:\u002F\u002Fgithub.com\u002Frook\u002Frook",[47],"nofollow"," · ",[38,50,51],{},"Documentation",[43,53,54],{"href":54,"rel":55},"https:\u002F\u002Frook.io",[47],[15,57,59],{"id":58},"dellhw_exporter-author","dellhw_exporter - Author",[11,61,62],{},"Prometheus exporter for Dell Hardware components using the Dell OMSA.",[11,64,65],{},"The exporter was originally made by PrFalken. Due to some issues in the code, I rewrote the whole exporter using the \"node_exporter\" pattern and therefore moved it from being a fork out, to a standalone repository.",[33,67,68],{},[11,69,70,41,72,48,76,41,78],{},[38,71,40],{},[43,73,74],{"href":74,"rel":75},"https:\u002F\u002Fgithub.com\u002Fgalexrt\u002Fdellhw_exporter",[47],[38,77,51],{},[43,79,80],{"href":80,"rel":81},"https:\u002F\u002Fdellhw-exporter.galexrt.moe",[47],[15,83,85],{"id":84},"modern-gaming-infrastructure-administrator","Modern Gaming - Infrastructure Administrator",[11,87,88],{},"I'm helping as a infrastructure administrator at the German Multi-Gaming Community \"Modern Gaming\".",[11,90,91],{},"The tasks I'm working on range from running web administration for the several websites and keeping the Gameservers running smoothly to introducing and maintaining automations to make the communities life easy.",[11,93,94],{},"Technology Stack: Kubernetes, Ansible, CI\u002FCD",[33,96,97],{},[11,98,99,41,102],{},[38,100,101],{},"Homepage",[43,103,104],{"href":104,"rel":105},"https:\u002F\u002Fmodern-gaming.net",[47],[15,107,109],{"id":108},"k8s-vagrant-multi-node-creator","k8s-vagrant-multi-node - Creator",[11,111,112],{},"An easy to run a Vagrant based Kubernetes Multi Node cluster for playing around (supports VirtualBox and libvirt).",[33,114,115],{},[11,116,117,41,119,48,123,41,125],{},[38,118,40],{},[43,120,121],{"href":121,"rel":122},"https:\u002F\u002Fgithub.com\u002Fgalexrt\u002Fk8s-vagrant-multi-node",[47],[38,124,51],{},[43,126,127],{"href":127,"rel":128},"https:\u002F\u002Fk8s-vagrant-multi-node.galexrt.moe",[47],[15,130,132],{"id":131},"past","Past",[134,135,18],"h3",{"id":136},"koor-technologies-inc-founding-engineer-1",[11,138,139],{},"I have worked on creating products around Rook Ceph to provide cloud native storage for container-based applications.",[134,141,143],{"id":142},"cloudical-devops-engineer","Cloudical - DevOps Engineer",[11,145,146],{},"I have worked at Cloudical Deutschland GmbH for over 3 years. In that time I have worked at several customer projects, ranging from the automotive industry to finance and startups.\nI helped Cloudical's customer succeed in their adventures into container technologies and the problems that can arise from these technologies.",[134,148,150],{"id":149},"_11-mail-media-development-technology-gmbh-junior-system-administrator","1&1 Mail & Media Development & Technology GmbH - Junior System Administrator",[11,152,153,154,158],{},"I have mainly worked on development and administration of Kubernetes clusters for applications.\nBesides containers, we have maintained automation services, such as GitLab, GoCD, Puppet, Vault, etc.\nTo keep the infrastructure we provide monitored we used Golang, to develop Prometheus exporters, e.g., ",[43,155,156],{"href":156,"rel":157},"https:\u002F\u002Fgithub.com\u002Fgalexrt\u002Fdellhw_exporter\u002F",[47],".",{"title":160,"searchDepth":161,"depth":161,"links":162},"",2,[163,164,165,166,167,168],{"id":17,"depth":161,"text":18},{"id":24,"depth":161,"text":25},{"id":58,"depth":161,"text":59},{"id":84,"depth":161,"text":85},{"id":108,"depth":161,"text":109},{"id":131,"depth":161,"text":132,"children":169},[170,172,173],{"id":136,"depth":171,"text":18},3,{"id":142,"depth":171,"text":143},{"id":149,"depth":171,"text":150},"md",{"icon":176},"i-ph-projector-screen",true,"\u002Fprojects",{"description":13},"6.projects","SdD1-Ss1YSuxN9iggrE26s-5T0thsQOc-L5-GJLNPSY",[183],{"title":184,"icon":185,"path":186,"stem":187,"children":188},"Docs","i-ph-book-open","\u002Fdocs","1.docs",[189,191,202,242,252,278,302,393,458,466,505,515,583,609,671],{"title":184,"path":186,"stem":190},"1.docs\u002Findex",{"icon":192,"title":193,"path":194,"stem":195,"children":196,"page":201},"i-ph-coffee-bean","Coffee","\u002Fdocs\u002Fcoffee","1.docs\u002Fcoffee",[197],{"title":198,"path":199,"stem":200},"Shops","\u002Fdocs\u002Fcoffee\u002Fshops","1.docs\u002Fcoffee\u002Fshops",false,{"icon":203,"title":204,"path":205,"stem":206,"children":207,"page":201},"i-ph-database","Databases","\u002Fdocs\u002Fdatabases","1.docs\u002Fdatabases",[208,212],{"title":209,"path":210,"stem":211},"MongoDB","\u002Fdocs\u002Fdatabases\u002Fmongodb","1.docs\u00